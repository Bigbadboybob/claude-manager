#!/usr/bin/env python3
"""External Codex account check. Cron and manual runs share a nonblocking flock.

Configure once with --configure --executable /absolute/native/codex --model MODEL.
Normal invocations read ~/.cm/codex-probe-config.json and atomically publish
~/.cm/codex-probe-state.json. No daemon or task session is signalled.
"""
import argparse
import datetime
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import tempfile
import time
import tomllib

MAX_BYTES = 4 * 1024 * 1024
TIMEOUT = 60
REPLY = "CM_CODEX_PROBE_OK"


def read_json(path):
    with Path(path).open("rb") as source:
        data = source.read(MAX_BYTES + 1)
    if len(data) > MAX_BYTES:
        raise ValueError("oversized data")
    return json.loads(data)


def atomic_write(path, value):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, temporary = tempfile.mkstemp(prefix=path.name + ".", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as output:
            json.dump(value, output, sort_keys=True, allow_nan=False)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def file_hash(path):
    with Path(path).open("rb") as source:
        return hashlib.file_digest(source, "sha256").hexdigest()


def version(executable):
    result = subprocess.run([executable, "--version"], check=True, capture_output=True, text=True, timeout=10)
    match = re.fullmatch(r"codex-cli ([0-9]+\.[0-9]+\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?)\s*", result.stdout)
    if not match:
        raise ValueError("unrecognized Codex version")
    return match[1]


def host_config(codex_home):
    path = codex_home / "config.toml"
    config = tomllib.loads(path.read_text()) if path.exists() else {}
    provider = config.get("model_provider", "openai")
    if config.get("model_providers", {}).get("openai"):
        raise ValueError("built-in provider cannot be overridden")
    model = config.get("model")
    if model is not None and not isinstance(model, str):
        raise ValueError("invalid configured model")
    result = {"model_provider": provider, "host_model": model,
              "provider_config": None, "auth_command_hash": None}
    if provider == "openai":
        return result
    if provider != "cm_pool":
        raise ValueError("provider configuration requires explicit support")
    definition = config.get("model_providers", {}).get(provider, {})
    command = definition.get("auth", {}).get("command")
    if not isinstance(command, str) or not Path(command).is_absolute() or not os.access(command, os.X_OK):
        raise ValueError("pool requires an absolute executable credential helper")
    expected = {"name": "openai", "base_url": "http://127.0.0.1:2455/backend-api/codex",
                "wire_api": "responses", "supports_websockets": True,
                "auth": {"command": command, "timeout_ms": 5000, "refresh_interval_ms": 300000}}
    if definition != expected:
        raise ValueError("pool provider differs from the supported local authentication contract")
    result.update(provider_config=definition, auth_command_hash=file_hash(command))
    return result


def toml_literal(value):
    if isinstance(value, dict):
        return "{" + ", ".join(json.dumps(k) + "=" + toml_literal(v) for k, v in sorted(value.items())) + "}"
    return json.dumps(value)


def provider_args(config):
    if config["model_provider"] == "openai":
        return []
    return ["-c", 'model_provider="cm_pool"', "-c",
            "model_providers.cm_pool=" + toml_literal(config["provider_config"])]


def configure(executable, model, codex_home):
    path = Path(executable)
    if not path.is_absolute() or not os.access(path, os.X_OK) or not model:
        raise ValueError("configuration requires an absolute executable and model")
    config = {"schema_version": 1, "executable": str(path.resolve()), "cli_version": version(str(path)),
              "executable_hash": file_hash(path), "requested_model": model,
              **host_config(codex_home), "codex_home": str(codex_home.resolve())}
    config["configuration_id"] = hashlib.sha256(json.dumps(config, sort_keys=True).encode()).hexdigest()
    return config


def validate_config(config, codex_home):
    if not isinstance(config, dict) or config.get("schema_version") != 1:
        raise ValueError("invalid probe configuration")
    for key in ["executable", "cli_version", "executable_hash", "requested_model", "model_provider", "configuration_id", "codex_home"]:
        if not isinstance(config.get(key), str) or not config[key]:
            raise ValueError("incomplete probe configuration")
    if not Path(config["executable"]).is_absolute() or any(config.get(key) != value for key, value in host_config(codex_home).items()) or config["codex_home"] != str(codex_home.resolve()):
        raise ValueError("runtime/provider mismatch")
    if file_hash(config["executable"]) != config["executable_hash"] or version(config["executable"]) != config["cli_version"]:
        raise ValueError("runtime changed since probe configuration was pinned")


def error_status(events, records):
    # Only structured runtime errors may carry account diagnoses. Never scan
    # assistant replies, tool output, stderr or user text for these phrases.
    errors = [r["payload"]["error"] for r in records
              if r.get("type") == "event_msg" and isinstance(r.get("payload"), dict)
              and r["payload"].get("type") == "task_complete" and isinstance(r["payload"].get("error"), dict)]
    errors += [r["error"] for r in events if r.get("type") == "turn.failed" and isinstance(r.get("error"), dict)]
    errors += [r for r in events if r.get("type") == "error"]
    for error in errors:
        code, message = error.get("codex_error_info"), error.get("message", "")
        if not isinstance(message, str):
            continue
        if code == "unauthorized" or message.startswith("unexpected status 401 Unauthorized:"):
            return "AUTH_EXPIRED"
        if code == "usage_limit_exceeded" or message == "You've hit your usage limit. Try again later.":
            return "USAGE_LIMITED"
        if code == "model_not_found" or (message.startswith("unexpected status 404 Not Found:") and "model" in message.lower()):
            return "MODEL_UNAVAILABLE"
        if message.startswith("unexpected status 503 Service Unavailable: No available accounts"):
            return "POOL_UNAVAILABLE"
    return "ERROR"


def rollout_records(codex_home, events, started):
    thread_ids = [event.get("thread_id") for event in events if event.get("type") == "thread.started"]
    if len(thread_ids) != 1 or not isinstance(thread_ids[0], str) or not re.fullmatch(r"[0-9a-f-]{36}", thread_ids[0]):
        return []
    # Only the new thread's UTC day (plus the next day across midnight).
    paths = []
    for stamp in [started, started + TIMEOUT + 60]:
        day = datetime.datetime.fromtimestamp(stamp, datetime.timezone.utc).strftime("%Y/%m/%d")
        paths += list((codex_home / "sessions" / day).glob("rollout-*" + thread_ids[0] + ".jsonl"))
    paths = list(set(paths))
    if len(paths) != 1:
        return []
    with paths[0].open("rb") as source:
        data = source.read(MAX_BYTES + 1)
    if len(data) > MAX_BYTES:
        return []
    return [json.loads(line) for line in data.splitlines() if line.strip()]


def probe(config, codex_home, timeout=TIMEOUT):
    started = time.time()
    state = {"schema_version": 1, "engine": "codex", "status": "ERROR", "started_at": started,
             "observed_model": None, "detail": "Probe did not establish a model completion."}
    for key in ["executable", "cli_version", "executable_hash", "requested_model", "configuration_id", "model_provider", "codex_home", "provider_config", "auth_command_hash"]:
        state[key] = config.get(key) if isinstance(config, dict) else None
    try:
        validate_config(config, codex_home)
        with tempfile.TemporaryDirectory(prefix="cm-codex-probe-") as scratch, tempfile.TemporaryFile() as output, tempfile.TemporaryFile() as errors:
            env = {k: v for k, v in os.environ.items() if not k.startswith("CM_") and k not in ("OPENAI_API_KEY", "CODEX_API_KEY", "OPENAI_BASE_URL")}
            env["CODEX_HOME"] = str(codex_home)
            args = [config["executable"], "exec", "--json", "--ignore-user-config", "--ignore-rules", "--skip-git-repo-check",
                    "--sandbox", "read-only", "--model", config["requested_model"], "--cd", scratch,
                    "-c", "project_doc_max_bytes=0", "-c", 'web_search="disabled"', "-c", "features.shell_tool=false",
                    "-c", "features.multi_agent=false", *provider_args(config),
                    "Respond with exactly " + REPLY + ". Do not use tools."]
            process = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=output, stderr=errors, env=env, start_new_session=True)
            try:
                process.wait(timeout=timeout)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait()
                state.update(status="TIMEOUT", detail="Disposable probe exceeded its request timeout; its process group was terminated.")
                return state
            output.seek(0)
            data = output.read(MAX_BYTES + 1)
            if len(data) > MAX_BYTES:
                raise ValueError("probe output exceeds bound")
            events = [json.loads(line) for line in data.splitlines() if line.strip()]
            if any(not isinstance(event, dict) for event in events):
                raise ValueError("invalid event stream")
            records = rollout_records(codex_home, events, started)
            contexts = [r["payload"] for r in records if r.get("type") == "turn_context"]
            metadata = [r["payload"] for r in records if r.get("type") == "session_meta"]
            finals = [r["payload"] for r in records if r.get("type") == "event_msg" and r.get("payload", {}).get("type") == "task_complete"]
            state["observed_model"] = contexts[-1].get("model") if contexts else None
            replies = [e["item"].get("text") for e in events if e.get("type") == "item.completed" and e.get("item", {}).get("type") == "agent_message"]
            success = (process.returncode == 0 and events and events[-1].get("type") == "turn.completed"
                       and replies == [REPLY] and len(contexts) == 1 and state["observed_model"] == config["requested_model"]
                       and len(metadata) == 1 and metadata[0].get("id") == next((e.get("thread_id") for e in events if e.get("type") == "thread.started"), None) and metadata[0].get("cli_version") == config["cli_version"]
                       and metadata[0].get("model_provider") == config["model_provider"]
                       and len(finals) == 1 and not finals[0].get("error") and finals[0].get("last_agent_message") == REPLY
                       and not any(e.get("type") in ("error", "turn.failed") for e in events)
                       and not any(e.get("type", "").startswith("item.") and e.get("item", {}).get("type") != "agent_message" for e in events))
            validate_config(config, codex_home)  # an update racing the request cannot certify the old pin
            state["status"] = "OK" if success else error_status(events, records)
            state["detail"] = "Expected model completed the fixed response; rollout version/provider/model verified." if success else "Runtime completion failed or its required evidence was missing; no recovery authorized."
    except (OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError):
        state.update(status="ERROR", detail="Probe configuration, runtime, output or model evidence could not be verified.")
    finally:
        state["checked_at"] = time.time()
    return state


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", type=Path, default=Path.home() / ".cm/codex-probe-config.json")
    parser.add_argument("--state", type=Path, default=Path.home() / ".cm/codex-probe-state.json")
    parser.add_argument("--lock", type=Path, default=Path.home() / ".cm/codex-probe.lock")
    parser.add_argument("--configure", action="store_true")
    parser.add_argument("--executable")
    parser.add_argument("--model")
    args = parser.parse_args(argv)
    codex_home = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex")))
    args.lock.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd = os.open(args.lock, os.O_CREAT | os.O_RDWR, 0o600)
    with os.fdopen(fd, "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0  # another scheduled/manual check owns it; leave its state alone
        if args.configure:
            if not args.executable or not args.model:
                parser.error("--configure requires --executable and --model")
            atomic_write(args.config, configure(args.executable, args.model, codex_home))
            return 0
        try:
            config = read_json(args.config)
        except (OSError, ValueError):
            config = {}
        state = probe(config, codex_home)
        atomic_write(args.state, state)
        print(json.dumps({"status": state["status"], "checked_at": state["checked_at"], "detail": state["detail"]}))
        return 0 if state["status"] == "OK" else 1


if __name__ == "__main__":
    raise SystemExit(main())

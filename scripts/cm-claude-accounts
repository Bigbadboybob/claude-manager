#!/usr/bin/env python3
"""Keep several Claude logins on this machine and switch the active one.

Switching rewrites ~/.claude/.credentials.json in place, as /login does;
running Claude Code sessions follow it. Saved logins live in
~/.config/cm-claude-accounts/ (mode 0700) and are never printed.
See doc/claude-account-switcher.md.
"""

from __future__ import annotations

import argparse
import email.utils
from dataclasses import dataclass
from datetime import datetime, timezone
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import socket
import struct
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request


LOCK_WAIT_SECONDS = 10.0
# Claude Code's waiters give up after roughly 7.5 s; stay well inside that.
MAX_HOLD_SECONDS = 3.0
HISTORY_LIMIT = 200


class AccountError(Exception):
    pass


class TokenRejected(AccountError):
    """Anthropic answered 401: the access token expired early or was revoked."""


class RateLimited(AccountError):
    """Anthropic answered 429. retry_after is its Retry-After in seconds, if any."""

    def __init__(self, message: str, retry_after: float | None = None):
        super().__init__(message)
        self.retry_after = retry_after


@dataclass(frozen=True)
class Paths:
    claude_dir: Path
    claude_json: Path
    store: Path

    @classmethod
    def default(cls) -> "Paths":
        home = Path.home()
        return cls(home / ".claude", home / ".claude.json", home / ".config/cm-claude-accounts")

    @property
    def credentials(self) -> Path:
        return self.claude_dir / ".credentials.json"

    @property
    def refresh_locks(self) -> tuple[Path, Path]:
        # Claude Code 2.1.308: current lock, then the legacy <realpath>.lock.
        return (self.claude_dir / ".oauth_refresh.lock",
                Path(os.path.realpath(self.claude_dir) + ".lock"))

    @property
    def accounts(self) -> Path:
        return self.store / "accounts"

    @property
    def state(self) -> Path:
        return self.store / "state.json"


# --- files -----------------------------------------------------------------

def load_json(path: Path) -> dict:
    try:
        with open(path) as f:
            data = json.load(f)
    except FileNotFoundError:
        return {}
    if not isinstance(data, dict):
        raise AccountError(f"{path} does not hold a JSON object")
    return data


def atomic_write(path: Path, data: dict, mode: int = 0o600, indent: int | None = None) -> None:
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, indent=indent)
        os.chmod(tmp, mode)
        os.rename(tmp, path)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise


def write_in_place(path: Path, data: dict) -> None:
    """Rewrite keeping the inode, as /login does; running sessions follow it."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(json.dumps(data))
        f.truncate()
        f.flush()
        os.fsync(f.fileno())
    os.chmod(path, 0o600)


def read_login(paths: Paths) -> dict:
    oauth = load_json(paths.credentials).get("claudeAiOauth")
    if not isinstance(oauth, dict) or not oauth.get("refreshToken"):
        raise AccountError("no Claude login in .credentials.json; run /login first")
    return oauth


def read_profile(paths: Paths) -> dict | None:
    profile = load_json(paths.claude_json).get("oauthAccount")
    return profile if isinstance(profile, dict) and profile.get("accountUuid") else None


def write_profile(paths: Paths, profile: dict, attempts: int = 20) -> None:
    """Replace only oauthAccount; retry if a session rewrites the file meanwhile."""
    for _ in range(attempts):
        before = os.stat(paths.claude_json)
        data = load_json(paths.claude_json)
        data["oauthAccount"] = profile
        if os.stat(paths.claude_json).st_mtime_ns != before.st_mtime_ns:
            continue
        atomic_write(paths.claude_json, data, before.st_mode & 0o777, indent=2)
        return
    raise AccountError(f"{paths.claude_json} kept changing; profile not updated")


# --- store -----------------------------------------------------------------

def init_store(paths: Paths) -> None:
    paths.accounts.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(paths.store, 0o700)
    os.chmod(paths.accounts, 0o700)


def load_accounts(paths: Paths) -> dict[str, dict]:
    out = {}
    if paths.accounts.is_dir():
        for path in sorted(paths.accounts.glob("*.json")):
            record = load_json(path)
            out[record["oauthAccount"]["accountUuid"]] = record
    return out


def save_account(paths: Paths, record: dict) -> None:
    uuid = record["oauthAccount"]["accountUuid"]
    atomic_write(paths.accounts / f"{uuid}.json", record)


def label(record: dict) -> str:
    profile = record["oauthAccount"]
    return f"{profile.get('emailAddress') or '?'} ({profile['accountUuid'][:8]})"


def record_history(state: dict, event: str, **fields) -> None:
    history = state.setdefault("history", [])
    history.append({"at": int(time.time()), "event": event, **fields})
    del history[:-HISTORY_LIMIT]


def resolve(accounts: dict[str, dict], name: str) -> str:
    """Accept an email or a unique accountUuid prefix."""
    matches = [uuid for uuid, rec in accounts.items()
               if rec["oauthAccount"].get("emailAddress", "").lower() == name.lower()]
    if not matches:
        matches = [uuid for uuid in accounts if uuid.startswith(name)]
    if len(matches) != 1:
        raise AccountError(f"{name!r} matches {len(matches)} saved accounts; see `list`")
    return matches[0]


# --- Claude Code's refresh lock ---------------------------------------------

class RefreshLock:
    """Claude Code's proper-lockfile directories, taken in Claude Code's order.

    No owner record is written, so waiters never take over early; if this
    process dies, the 60 s staleness rule frees the directories.
    """

    def __init__(self, paths: Paths, wait: float = LOCK_WAIT_SECONDS):
        self.dirs = paths.refresh_locks
        self.wait = wait
        self.held: list[Path] = []
        self.acquired_at = 0.0

    def __enter__(self) -> "RefreshLock":
        deadline = time.monotonic() + self.wait
        while True:
            try:
                for d in self.dirs:
                    os.mkdir(d)
                    self.held.append(d)
                self.acquired_at = time.monotonic()
                return self
            except FileExistsError:
                self._release()
                if time.monotonic() >= deadline:
                    raise AccountError("a Claude Code session is refreshing its token "
                                       "(refresh lock busy); nothing changed, try again")
                time.sleep(0.2)

    def touch(self) -> None:
        for d in self.held:
            os.utime(d)

    def __exit__(self, *exc) -> None:
        self._release()

    def _release(self) -> None:
        while self.held:
            try:
                os.rmdir(self.held.pop())
            except FileNotFoundError:
                pass


# --- identity ----------------------------------------------------------------

PROFILE_URL = "https://api.anthropic.com/api/oauth/profile"
PROFILE_TIMEOUT_SECONDS = 10
IDENTIFY_ATTEMPTS = 3


def fetch_account_uuid(access_token: str) -> str:
    """Ask Anthropic whose login this is: the request Claude Code itself makes.

    Read-only; it never refreshes. Errors name the status only, never the token.
    """
    req = urllib.request.Request(PROFILE_URL, headers={
        "Authorization": f"Bearer {access_token}",
        "Content-Type": "application/json",
        "Cache-Control": "no-cache",
        "User-Agent": "cm-claude-accounts",
    })
    try:
        with urllib.request.urlopen(req, timeout=PROFILE_TIMEOUT_SECONDS) as resp:
            uuid = json.load(resp).get("account", {}).get("uuid")
    except urllib.error.HTTPError as exc:
        if exc.code == 429:
            raise RateLimited("profile requests are rate limited (HTTP 429)") from None
        error = TokenRejected if exc.code == 401 else AccountError
        raise error(f"Anthropic rejected the current access token (HTTP {exc.code})") from None
    except (urllib.error.URLError, TimeoutError, ValueError) as exc:
        raise AccountError(f"could not reach Anthropic to confirm the account ({type(exc).__name__})") from None
    if not isinstance(uuid, str) or not uuid:
        raise AccountError("Anthropic's profile response had no account uuid")
    return uuid


def identify(login: dict, accounts: dict[str, dict]) -> tuple[str, str]:
    """Return (accountUuid, how) for a login. The profile in ~/.claude.json is
    never evidence: sessions can write a stale one back."""
    for uuid, rec in accounts.items():
        if rec["claudeAiOauth"].get("refreshToken") == login["refreshToken"]:
            return uuid, "token"
    expires = login.get("expiresAt")
    if isinstance(expires, (int, float)) and expires / 1000 <= time.time():
        raise AccountError("the current login has rotated and its access token has expired, "
                           "so its account cannot be confirmed; send any prompt in a Claude "
                           "session (it refreshes the token) and retry, or run /login + `capture`")
    try:
        return fetch_account_uuid(login["accessToken"]), "confirmed"
    except AccountError as exc:
        # Keep the type: poll skips a rejected token instead of failing.
        raise type(exc)(f"cannot confirm which account the current login belongs to: {exc}; "
                           "retry, or run /login for it and `capture`") from None


def identify_locked(paths: Paths, accounts: dict[str, dict]):
    """Identify the live login outside the lock (it may need the network), then
    take the lock and check the file did not change meanwhile.

    Returns (lock, login, uuid, how) with the lock held; the caller exits it.
    """
    for _ in range(IDENTIFY_ATTEMPTS):
        login = read_login(paths)
        uuid, how = identify(login, accounts)
        lock = RefreshLock(paths).__enter__()
        try:
            if read_login(paths)["refreshToken"] == login["refreshToken"]:
                return lock, login, uuid, how
        except BaseException:
            lock.__exit__(None, None, None)
            raise
        lock.__exit__(None, None, None)  # a session refreshed meanwhile; look again
    raise AccountError("the login kept changing while being identified; try again")


def save_login(paths: Paths, accounts: dict[str, dict], uuid: str, login: dict,
               profile: dict | None) -> dict:
    """Store a confirmed login. A new account needs a profile naming it."""
    now = int(time.time())
    record = accounts.get(uuid)
    if record is None:
        if not profile or profile["accountUuid"] != uuid:
            raise AccountError(f"the current login is account {uuid[:8]}, which is not saved and "
                               f"{paths.claude_json} does not describe it; run /login, then `capture`")
        record = {"captured_at": now}
    if profile and profile["accountUuid"] == uuid:
        record["oauthAccount"] = profile
    record.update(claudeAiOauth=login, updated_at=now)
    record.pop("needs_login", None)
    accounts[uuid] = record
    save_account(paths, record)
    return record


def persist_state(paths: Paths, state: dict) -> None:
    atomic_write(paths.state, state, indent=2)


# --- usage -------------------------------------------------------------------

USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
USAGE_TIMEOUT_SECONDS = 15
# Percent at which the active account alerts, per limit kind (doc: 80% of the
# 5-hour limit, 90% of a weekly one). Override in state.json "config".
DEFAULT_THRESHOLDS = {"session": 80, "weekly": 90}
FAILURE_ALERT_AFTER = 3
# After a 429, wait at least this long, doubling per consecutive 429.
RATE_LIMIT_BACKOFF_SECONDS = 15 * 60
RATE_LIMIT_BACKOFF_MAX_SECONDS = 2 * 3600
UNDELIVERED_RETRY_SECONDS = 3600
# The API's resets_at jitters by under a second between readings; a reset
# this far from the alerted one is a new period.
NEW_PERIOD_SECONDS = 3600
DEFAULT_NOTIFY = Path.home() / ".cm/bin/cm-notify"
# The timer runs every 2 min (hub check-ins); usage is read at most this often.
USAGE_INTERVAL_SECONDS = 9 * 60


def fetch_usage(access_token: str) -> dict:
    """The data /usage shows. Read-only; never refreshes."""
    req = urllib.request.Request(USAGE_URL, headers={
        "Authorization": f"Bearer {access_token}",
        "Content-Type": "application/json",
        "User-Agent": "cm-claude-accounts",
    })
    try:
        with urllib.request.urlopen(req, timeout=USAGE_TIMEOUT_SECONDS) as resp:
            data = json.load(resp)
    except urllib.error.HTTPError as exc:
        if exc.code == 401:
            raise TokenRejected("Anthropic rejected the current access token (HTTP 401)") from None
        if exc.code == 429:
            raise RateLimited("usage requests are rate limited (HTTP 429)",
                              parse_retry_after(exc.headers.get("Retry-After") if exc.headers else None)) from None
        raise AccountError(f"usage request failed (HTTP {exc.code})") from None
    except (urllib.error.URLError, TimeoutError, ValueError) as exc:
        raise AccountError(f"could not reach Anthropic for usage ({type(exc).__name__})") from None
    if not isinstance(data, dict):
        raise AccountError("usage response was not a JSON object")
    return data


def parse_retry_after(value: str | None) -> float | None:
    if not value:
        return None
    try:
        return max(0.0, float(value))
    except ValueError:
        pass
    try:
        return max(0.0, email.utils.parsedate_to_datetime(value).timestamp() - time.time())
    except (TypeError, ValueError):
        return None


def parse_time(value) -> float | None:
    if isinstance(value, (int, float)):
        return value / 1000 if value > 1e11 else float(value)
    if isinstance(value, str) and value:
        try:
            return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
        except ValueError:
            return None
    return None


def scope_text(value) -> str | None:
    """A limit's scope as a short name. weekly_scoped scopes are objects such
    as {"model": {"id": null, "display_name": "Fable"}, "surface": null}."""
    if isinstance(value, str):
        return value or None
    if isinstance(value, dict):
        model = value.get("model")
        if isinstance(model, dict):
            name = model.get("display_name") or model.get("id")
            if isinstance(name, str) and name:
                return name
        if isinstance(model, str) and model:
            return model
        surface = value.get("surface")
        if isinstance(surface, str) and surface:
            return surface
    return None


def parse_limits(usage: dict) -> list[dict]:
    """Normalize the response's limits list. Plans differ (some have no 5-hour
    limit) and the format is undocumented, so skip anything unrecognized."""
    out = []
    raw = usage.get("limits")
    if isinstance(raw, list):
        for item in raw:
            if not isinstance(item, dict) or not isinstance(item.get("kind"), str):
                continue
            percent = item.get("percent")
            if not isinstance(percent, (int, float)) or isinstance(percent, bool):
                continue
            out.append({
                "kind": item["kind"],
                "scope": scope_text(item.get("scope")),
                "group": scope_text(item.get("group")),
                "percent": percent,
                "active": item.get("is_active") is True,
                "severity": item.get("severity") if isinstance(item.get("severity"), str) else None,
                "resets_at": parse_time(item.get("resets_at")),
            })
        return out
    # Older shape: fixed five_hour / seven_day objects.
    for field, kind in (("five_hour", "session"), ("seven_day", "weekly_all")):
        item = usage.get(field)
        if isinstance(item, dict) and isinstance(item.get("utilization"), (int, float)):
            out.append({"kind": kind, "scope": None, "group": None, "percent": item["utilization"],
                        "active": False, "severity": None,
                        "resets_at": parse_time(item.get("resets_at"))})
    return out


def limit_name(limit: dict) -> str:
    kind = limit["kind"]
    if kind == "session":
        return "5h"
    if kind == "weekly_all":
        return "week"
    if kind.startswith("weekly"):
        return f"week:{limit['scope'] or limit.get('group') or kind}"
    return kind if not limit["scope"] else f"{kind}:{limit['scope']}"


def threshold_for(limit: dict, config: dict) -> float:
    thresholds = {**DEFAULT_THRESHOLDS, **(config.get("thresholds") or {})}
    family = "session" if limit["kind"] == "session" else "weekly"
    return thresholds.get(limit["kind"], thresholds[family])


def describe_reset(resets_at: float | None, now: float) -> str:
    if resets_at is None:
        return "reset ?"
    left = resets_at - now
    if left <= 0:
        return "reset passed"
    if left < 3600:
        return f"resets in {left / 60:.0f}m"
    if left < 86400:
        return f"resets in {left / 3600:.1f}h"
    return f"resets in {left / 86400:.1f}d"


def log_alert(paths: Paths, message: str) -> None:
    with open(paths.store / "alerts.log", "a") as log:
        log.write(f"{datetime.fromtimestamp(time.time(), timezone.utc).isoformat()} {message}\n")
    os.chmod(paths.store / "alerts.log", 0o600)


def notify_tag() -> str:
    """cm-notify labels every message "cm-manager"; the tag says which host sent it."""
    host = socket.gethostname().split(".")[0]
    return f"claude-accounts@{host}" if host else "claude-accounts"


def notify(state: dict, paths: Paths, message: str, command: str) -> bool:
    """Send an operator alert; always log it. Messages name accounts, never tokens."""
    now = int(time.time())
    log_alert(paths, message)
    delivered, why = False, None
    try:
        result = subprocess.run([command, message], capture_output=True, timeout=30,
                                env=dict(os.environ, CM_NOTIFY_TAG=notify_tag()))
        delivered = result.returncode == 0
        why = None if delivered else f"notifier exited {result.returncode}"
    except (OSError, subprocess.TimeoutExpired) as exc:
        why = f"notifier failed ({type(exc).__name__})"
    # The notifier's output may hold its own credentials; never keep it.
    state["last_alert"] = {"at": now, "message": message, "delivered": delivered,
                           **({"error": why} if why else {})}
    return delivered


def alert_due(entry, now: float) -> bool:
    """Send unless already delivered; retry an undelivered one hourly."""
    if entry is None:
        return True
    if not isinstance(entry, dict):  # older state: a bare timestamp meant sent
        return False
    return not entry.get("delivered") and now - entry.get("at", 0) >= UNDELIVERED_RETRY_SECONDS


def check_logins(state: dict, accounts: dict[str, dict], alert) -> None:
    """Alert once per account whose saved login has expired or been refused."""
    sent = state.setdefault("login_alerts", {})
    now = time.time()
    for uuid, rec in accounts.items():
        expires = rec["claudeAiOauth"].get("refreshTokenExpiresAt")
        expired = isinstance(expires, (int, float)) and expires / 1000 <= now
        if not (expired or rec.get("needs_login")):
            sent.pop(uuid, None)
            continue
        if alert_due(sent.get(uuid), now):
            delivered = alert(f"{label(rec)} needs a new login: /login as it, then "
                              "`cm-claude-accounts capture`")
            sent[uuid] = {"at": int(now), "delivered": delivered}


def check_limits(state: dict, uuid: str, record: dict, limits: list[dict], alert,
                 advice: str | None = None) -> None:
    """Alert once per limit per reset period when the active account crosses a threshold."""
    config = state.get("config") or {}
    sent = state.setdefault("limit_alerts", {})
    now = time.time()
    for key in [k for k, v in sent.items() if v.get("resets_at") and v["resets_at"] <= now]:
        del sent[key]
    for limit in limits:
        threshold = threshold_for(limit, config)
        if limit["percent"] < threshold:
            continue
        key = f"{uuid}:{limit['kind']}:{limit['scope'] or ''}:{limit.get('group') or ''}"
        entry = sent.get(key)
        if (entry and limit["resets_at"] and entry.get("resets_at")
                and abs(limit["resets_at"] - entry["resets_at"]) > NEW_PERIOD_SECONDS):
            entry = None
        if not alert_due(entry, now):
            continue
        delivered = alert(f"{label(record)} is at {limit['percent']:.0f}% of its "
                          f"{limit_name(limit)} limit ({describe_reset(limit['resets_at'], now)})"
                          + (f". {advice}" if advice else ""))
        sent[key] = {"at": int(now), "resets_at": limit["resets_at"], "delivered": delivered}


# --- autoswitch -----------------------------------------------------------------

DEFAULT_MIN_DWELL_MINUTES = 30


def over_threshold(limits: list[dict], config: dict, now: float,
                   for_switch: bool = False) -> list[dict]:
    """Limits at or over threshold whose reset has not passed. for_switch
    keeps only the limits that block every model (5-hour and all-models
    weekly): a full model-scoped limit alerts, but moving every session for
    one model needs "switch_on_scoped": true."""
    return [l for l in limits if l["percent"] >= threshold_for(l, config)
            and not (l.get("resets_at") is not None and l["resets_at"] <= now)
            and (not for_switch or l["kind"] in ("session", "weekly_all")
                 or config.get("switch_on_scoped"))]


def pick_target(state: dict, accounts: dict[str, dict], active: str | None,
                now: float) -> tuple[str, str, bool] | None:
    """The saved account with the most room, from the freshest reading on any
    host (decision 3: inactive accounts are never polled; peers read the ones
    active there). A limit whose reset has passed counts as empty. Accounts
    active on another host rank after idle ones with room, and accounts with
    no reading anywhere rank last. Excluded accounts never qualify.
    Returns (accountUuid, why, has_reading) or None."""
    config = state.get("config") or {}
    readings = merged_readings(state)
    busy = in_use_elsewhere(state, now)
    excluded = set(config.get("exclude") or []) | unavailable_here(state)
    ranked = []
    for uuid, rec in accounts.items():
        if (uuid == active or uuid in excluded
                or login_state(rec, now) in ("needs /login", "login expired")):
            continue
        elsewhere = busy.get(uuid)
        note = f"; active on {', '.join(elsewhere)}" if elsewhere else ""
        reading = readings.get(uuid)
        if not reading:
            ranked.append(((1, bool(elsewhere), 0.0), uuid, "no usage reading yet" + note, False))
            continue
        limits = reading.get("limits") or []
        if over_threshold(limits, config, now, for_switch=True):
            continue
        live = [l for l in limits if not (l.get("resets_at") is not None and l["resets_at"] <= now)]
        worst = max(live, key=lambda l: l["percent"] / threshold_for(l, config), default=None)
        source = f" on {reading['host']}" if reading.get("host") else ""
        if worst is None:
            why = "likely refilled"
        else:
            why = f"{limit_name(worst)} {worst['percent']:.0f}% {describe_age(now - reading['at'])}{source}"
        ratio = worst["percent"] / threshold_for(worst, config) if worst else 0.0
        ranked.append(((0, bool(elsewhere), ratio), uuid, why + note, True))
    if not ranked:
        return None
    _, uuid, why, has_reading = min(ranked, key=lambda r: (r[0], label(accounts[r[1]])))
    return uuid, why, has_reading


def switch_advice(state: dict, accounts: dict[str, dict], active: str, now: float) -> str:
    target = pick_target(state, accounts, active, now)
    if target is None:
        return "No other saved account has room"
    uuid, why, _ = target
    email = accounts[uuid]["oauthAccount"].get("emailAddress") or uuid
    return f"Suggest: cm-claude-accounts switch {email} ({why})"


# --- other hosts ------------------------------------------------------------------
#
# Each host keeps its own logins (never copied). Hosts share only readings:
# `export` prints accounts, usage and the active account, never tokens, and
# a host lists the others as "peers" (ssh aliases) to read them.

EXPORT_VERSION = 1
PEER_TIMEOUT_SECONDS = 20
# A peer's "active" is trusted for this long after it was read.
PEER_ACTIVE_FRESH_SECONDS = 3600
PEER_NAME = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_.@-]*$")
REMOTE_EXPORT = "python3 .local/bin/cm-claude-accounts export"


def export_view(paths: Paths, state: dict) -> dict:
    now = time.time()
    readings = state.get("usage") or {}
    out = {}
    for uuid, rec in load_accounts(paths).items():
        out[uuid] = {"email": rec["oauthAccount"].get("emailAddress"),
                     "login": login_state(rec, now),
                     "reading": readings.get(uuid)}
    poll = state.get("poll") or {}
    return {"version": EXPORT_VERSION, "host": host_name(state), "at": int(now),
            "active": state.get("active"), "accounts": out, "mode": effective_mode(state),
            "apply": state.get("apply"), "events": list(state.get("hub_outbox") or []),
            "sessions": state.get("sessions"),
            "poll": {k: poll[k] for k in ("at", "ok", "reason") if k in poll}}


def fetch_peer(host: str) -> dict:
    """Read another host's export over ssh. Errors name the host and exit status only."""
    if not PEER_NAME.match(host):
        raise AccountError(f"peer {host!r} is not a plain ssh host name")
    try:
        result = subprocess.run(
            ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", host, REMOTE_EXPORT],
            capture_output=True, text=True, timeout=PEER_TIMEOUT_SECONDS, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise AccountError(f"{host}: unreachable ({type(exc).__name__})") from None
    if result.returncode:
        raise AccountError(f"{host}: export failed (exit {result.returncode})")
    try:
        data = json.loads(result.stdout)
    except ValueError:
        raise AccountError(f"{host}: export was not JSON") from None
    if not isinstance(data, dict) or data.get("version") != EXPORT_VERSION \
            or not isinstance(data.get("accounts"), dict):
        raise AccountError(f"{host}: unsupported export (update cm-claude-accounts there)")
    return data


def refresh_peers(state: dict) -> None:
    """Read every configured peer in parallel; keep the last good copy on failure."""
    hosts = list((state.get("config") or {}).get("peers") or [])
    cache = state.setdefault("peers", {})
    for gone in [h for h in cache if h not in hosts]:
        del cache[gone]
    if not hosts:
        return
    results: dict[str, object] = {}

    def one(host):
        try:
            results[host] = fetch_peer(host)
        except AccountError as exc:
            results[host] = exc

    threads = [threading.Thread(target=one, args=(h,), daemon=True) for h in hosts]
    for t in threads:
        t.start()
    for t in threads:
        t.join(PEER_TIMEOUT_SECONDS + 5)
    now = int(time.time())
    for host in hosts:
        result = results.get(host, AccountError(f"{host}: no answer"))
        entry = cache.setdefault(host, {})
        if isinstance(result, dict):
            entry.clear()
            entry.update(at=now, ok=True, data=result)
        else:
            entry.update(tried_at=now, ok=False, error=str(result))


def merged_readings(state: dict) -> dict[str, dict]:
    """Per account, the freshest reading from here or any peer; a peer's
    carries "host"."""
    merged = {uuid: dict(r) for uuid, r in (state.get("usage") or {}).items()
              if isinstance(r, dict) and "at" in r}
    me = host_name(state)
    for uuid, reading in ((last_hub_reply(state) or {}).get("readings") or {}).items():
        if isinstance(reading, dict) and isinstance(reading.get("at"), (int, float)) \
                and isinstance(reading.get("limits"), list) and reading.get("host") != me \
                and (uuid not in merged or reading["at"] > merged[uuid]["at"]):
            merged[uuid] = dict(reading)
    for host, entry in (state.get("peers") or {}).items():
        for uuid, info in ((entry.get("data") or {}).get("accounts") or {}).items():
            reading = info.get("reading") if isinstance(info, dict) else None
            if not isinstance(reading, dict) or not isinstance(reading.get("at"), (int, float)) \
                    or not isinstance(reading.get("limits"), list):
                continue
            if uuid not in merged or reading["at"] > merged[uuid]["at"]:
                merged[uuid] = {**reading, "host": host}
    return merged


def in_use_elsewhere(state: dict, now: float) -> dict[str, list[str]]:
    busy: dict[str, list[str]] = {}
    me = host_name(state)
    for host, info in ((last_hub_reply(state) or {}).get("hosts") or {}).items():
        if host != me and isinstance(info, dict) and info.get("active") \
                and now - info.get("at", 0) <= PEER_ACTIVE_FRESH_SECONDS:
            busy.setdefault(info["active"], []).append(host)
    for host, entry in (state.get("peers") or {}).items():
        data = entry.get("data") or {}
        if data.get("active") and now - entry.get("at", 0) <= PEER_ACTIVE_FRESH_SECONDS:
            busy.setdefault(data["active"], []).append(host)
    return busy


def last_switch_at(state: dict) -> float:
    return max((h["at"] for h in state.get("history", []) if h.get("event") == "switch"), default=0)


DEFAULT_MAX_AUTO_SWITCHES_PER_DAY = 6


def auto_switches_since(state: dict, since: float) -> int:
    return sum(1 for h in state.get("history", []) if h.get("event") == "switch"
               and str(h.get("reason", "")).startswith("auto:") and h.get("at", 0) >= since)


def poll_failed(state: dict, reason: str, alert) -> int:
    print(f"poll failed: {reason}", file=sys.stderr)  # the journal shows why
    poll = state.setdefault("poll", {})
    poll.update(at=int(time.time()), ok=False, reason=reason)
    poll["failures"] = poll.get("failures", 0) + 1
    if poll["failures"] == FAILURE_ALERT_AFTER:
        alert(f"usage poll failed {FAILURE_ALERT_AFTER} times in a row: {reason}")
    return 1


def poll_rate_limited(state: dict, exc: RateLimited, out) -> int:
    """Back off instead of failing: the endpoint's limit may be shared with
    Owner's own /usage, so never keep hitting it."""
    poll = state.setdefault("poll", {})
    streak = poll.get("rate_limited", 0) + 1
    wait = min(RATE_LIMIT_BACKOFF_SECONDS * 2 ** (streak - 1), RATE_LIMIT_BACKOFF_MAX_SECONDS)
    wait = max(wait, exc.retry_after or 0)
    now = int(time.time())
    poll.update(at=now, ok=False, skipped=True, reason=str(exc), rate_limited=streak,
                backoff_until=now + int(wait))
    print(f"skipped: {exc}; no usage request for {wait / 60:.0f} min", file=out)
    return 0


def poll_skipped(state: dict, reason: str) -> int:
    """Not a failure: the next prompt from any session renews the token."""
    poll = state.setdefault("poll", {})
    poll.update(at=int(time.time()), ok=False, reason=reason, skipped=True)
    return 0



# --- post-switch sweep ----------------------------------------------------------------
#
# About 1 in 20-30 sessions errors after a switch, and sessions that stopped on
# the limit that caused it stay stopped. For a while after any switch, re-prompt
# each idle Claude session whose last transcript entry is an API error, once per
# switch, through this host's own CM daemon. Never bash shells, never sessions a
# continuous task or workflow owns (their scheduler does), and Owner's own
# sessions (no managing agent) only with `config sweep_owner_sessions true`.

SWEEP_WINDOW_SECONDS = 30 * 60
SWEEP_MAX_PER_RUN = 20
# A session that stopped on a usage limit this long before the switch still counts.
STOPPED_ON_LIMIT_LOOKBACK_SECONDS = 12 * 3600
OWNER_ERRORS = {"oauth_org_not_allowed", "account_on_hold"}
REPROMPT_TEXT = "Continue where you left off (the Claude account was switched)."
TRANSCRIPT_TAIL_BYTES = 256 * 1024


def daemon_rpc(method: str, params: dict, timeout: float = 10.0):
    """One operator call to this host's CM daemon (the framing scripts/cm-op uses)."""
    home = Path.home()
    try:
        token = (home / ".cm/operator-token").read_text().strip()
        sock_path = os.environ.get("CM_DAEMON_SOCKET") or str(home / ".cm/daemon.sock")
        with socket.socket(socket.AF_UNIX) as sock:
            sock.settimeout(timeout)
            sock.connect(sock_path)
            req = json.dumps({"id": "cm-claude-accounts", "caller": {"token_id": token},
                              "method": method, "params": params}).encode()
            sock.sendall(struct.pack(">I", len(req)) + req)
            header = sock.recv(4)
            if len(header) < 4:
                raise AccountError(f"CM daemon closed the connection on {method}")
            length = struct.unpack(">I", header)[0]
            buf = b""
            while len(buf) < length:
                chunk = sock.recv(length - len(buf))
                if not chunk:
                    break
                buf += chunk
    except (OSError, ValueError) as exc:
        raise AccountError(f"CM daemon unavailable ({type(exc).__name__})") from None
    try:
        reply = json.loads(buf)
    except ValueError:
        raise AccountError(f"CM daemon sent a bad reply to {method}") from None
    if not reply.get("ok", True) or reply.get("error"):
        raise AccountError(f"CM daemon refused {method}: {(reply.get('error') or {}).get('code')}")
    return reply.get("result")


def last_transcript_entry(path: str) -> dict | None:
    """The last user or assistant entry of a Claude transcript."""
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - TRANSCRIPT_TAIL_BYTES))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return None
    for line in reversed(lines):
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if isinstance(entry, dict) and entry.get("type") in ("user", "assistant"):
            return entry
    return None


def claude_sessions(state: dict) -> list[dict] | None:
    try:
        result = daemon_rpc("list_sessions", {})
    except AccountError:
        state["sessions"] = None
        return None
    items = result.get("sessions") if isinstance(result, dict) else result
    sessions = [i for i in items or [] if isinstance(i, dict) and i.get("type") == "claude-code"
                and i.get("state") not in ("exited", "dead")]
    state["sessions"] = {"at": int(time.time()), "live": len(sessions),
                         "busy": sum(1 for i in sessions if not i.get("idle"))}
    return sessions


def sweep_eligible(item: dict, config: dict) -> bool:
    if item.get("type") != "claude-code":
        return False
    if item.get("continuous_task_id") or item.get("workflow_run_id") or item.get("workflow_role"):
        return False
    if not item.get("managed_by_uid") and not config.get("sweep_owner_sessions"):
        return False
    return True


def sweep(paths: Paths, state: dict, out, alert, alert_owner) -> None:
    sessions = claude_sessions(state)
    switched = last_switch_at(state)
    now = time.time()
    if sessions is None or not switched or now - switched > SWEEP_WINDOW_SECONDS \
            or (state.get("config") or {}).get("sweep") is False:
        return
    done = state.setdefault("reprompted", {})
    for key in [k for k, at in done.items() if now - at > 2 * 86400]:
        del done[key]
    prompted, owner = [], []
    # Two switches can share a second; the count tells them apart.
    switch_count = sum(1 for h in state.get("history", []) if h.get("event") == "switch")
    for item in sessions:
        uid = item.get("session_uid")
        key = f"{uid}@{int(switched)}#{switch_count}"
        if not uid or not item.get("idle") or key in done \
                or not sweep_eligible(item, state.get("config") or {}):
            continue
        try:
            info = daemon_rpc("resolve_authorized_session", {"session_uid": uid})
        except AccountError:
            continue
        entry = last_transcript_entry((info or {}).get("transcript_path") or "")
        if not entry or entry.get("type") != "assistant" or not entry.get("isApiErrorMessage"):
            continue
        at = parse_time(entry.get("timestamp"))
        error = entry.get("error")
        if at is None or (at < switched and not (
                error == "rate_limit" and switched - at <= STOPPED_ON_LIMIT_LOOKBACK_SECONDS)):
            continue
        name = item.get("label") or uid
        if error in OWNER_ERRORS:
            done[key] = now
            owner.append(f"{name} ({error})")
            continue
        if len(prompted) >= SWEEP_MAX_PER_RUN:
            break
        try:
            daemon_rpc("send_input", {"session_uid": uid, "text": REPROMPT_TEXT, "submit": True})
        except AccountError as exc:
            print(f"warning: could not re-prompt {name}: {exc}", file=sys.stderr)
            continue
        done[key] = now
        prompted.append(f"{name} ({error or 'error'})")
        log_alert(paths, f"sweep: re-prompted {name} [{uid}] after {error or 'an API error'} "
                         f"at {entry.get('timestamp')}")
    me = host_name(state)
    if prompted:
        record_history(state, "sweep", reprompted=len(prompted), reason=", ".join(prompted)[:500])
        alert(f"{me}: re-prompted {len(prompted)} session(s) stopped by an API error around the "
              f"last switch: {', '.join(prompted)}")
    if owner:
        alert_owner(f"{me}: sessions refused by Anthropic for a billing or account problem, not "
                    f"re-prompted: {', '.join(owner)}")


# --- hub: the coordinator's control plane -------------------------------------------
#
# cm-manager keeps the desired state (which account each host uses, reservations,
# drains, policy) and every host's last report. Hosts check in over outbound ssh
# from their own timer, so the laptop needs no inbound access. See
# doc/claude-account-switcher.md, "Coordinator control plane".

HUB_VERSION = 1
HUB_TIMEOUT_SECONDS = 20
HUB_OUTBOX_LIMIT = 50
HUB_ALERTS_LIMIT = 2000
HUB_REPORT_FRESH_SECONDS = 15 * 60
REMOTE_CHECKIN = "python3 .local/bin/cm-claude-accounts hub checkin"
MODES = ("pin", "auto", "manual")
# Swarm-Coord for Owner, 2026-11-10; the coordinator edits it as Owner names priorities.
DEFAULT_CRITICAL = ["trading system: live and real-money work", "the account coordinator itself"]
DEFAULT_LOW_ROOM_ACCOUNTS = 1


def host_name(state: dict) -> str:
    name = (state.get("config") or {}).get("host_name")
    return name or socket.gethostname().split(".")[0] or "host"


def last_hub_reply(state: dict) -> dict | None:
    hub = state.get("hub") or {}
    return hub.get("reply") if isinstance(hub.get("reply"), dict) else None


def effective_mode(state: dict) -> str:
    """With a hub, its entry for this host rules (default manual); without
    one, the local autoswitch setting. manual behaves like suggest."""
    config = state.get("config") or {}
    if config.get("hub"):
        reply = last_hub_reply(state)
        entry = (reply or {}).get("entry") or {}
        mode = entry.get("mode") or ((reply or {}).get("policy") or {}).get("default_mode") or "manual"
    else:
        mode = config.get("autoswitch", "suggest")
    return "suggest" if mode == "manual" else mode


def unavailable_here(state: dict) -> set[str]:
    """Accounts the hub says this host may not switch to: draining, or
    reserved for other hosts."""
    reply = last_hub_reply(state) or {}
    me = host_name(state)
    out = set(reply.get("draining") or [])
    for uuid, res in (reply.get("reservations") or {}).items():
        if me not in (res.get("for") or []):
            out.add(uuid)
    return out


def hub_exchange(paths: Paths, state: dict, out) -> dict | None:
    """Check in with the hub; returns its reply, or None with no hub or on
    failure (the host then keeps its account)."""
    hub = (state.get("config") or {}).get("hub")
    if not hub:
        return None
    export = export_view(paths, state)
    now = int(time.time())
    try:
        if hub == "local":
            with Hub(paths) as h:
                reply = hub_checkin(h, export)
        else:
            reply = remote_checkin(hub, export)
    except AccountError as exc:
        entry = state.setdefault("hub", {})
        entry.update(ok=False, error=str(exc), tried_at=now)
        print(f"hub check-in failed: {exc}", file=sys.stderr)
        return None
    state["hub"] = {"at": now, "ok": True, "reply": reply}
    sent = {e.get("id") for e in export["events"]}
    state["hub_outbox"] = [e for e in state.get("hub_outbox") or [] if e.get("id") not in sent]
    return reply


def remote_checkin(hub: str, export: dict) -> dict:
    if not PEER_NAME.match(hub):
        raise AccountError(f"hub {hub!r} is not a plain ssh host name")
    try:
        result = subprocess.run(
            ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", hub,
             f"{REMOTE_CHECKIN} {export['host']}"],
            input=json.dumps(export), capture_output=True, text=True, timeout=HUB_TIMEOUT_SECONDS)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise AccountError(f"{hub}: unreachable ({type(exc).__name__})") from None
    if result.returncode:
        raise AccountError(f"{hub}: check-in failed (exit {result.returncode})")
    try:
        reply = json.loads(result.stdout)
    except ValueError:
        raise AccountError(f"{hub}: check-in reply was not JSON") from None
    if not isinstance(reply, dict) or reply.get("version") != HUB_VERSION:
        raise AccountError(f"{hub}: unsupported hub reply (update cm-claude-accounts there)")
    return reply


def apply_assignment(paths: Paths, state: dict, accounts: dict[str, dict], reply: dict, out) -> None:
    """Converge on a pinned account. Each result goes to the hub next check-in."""
    entry = reply.get("entry") or {}
    target = entry.get("account")
    if entry.get("mode") != "pin" or not target:
        return
    rev = reply.get("revision")
    now = int(time.time())
    me = host_name(state)
    if target == state.get("active"):
        state["apply"] = {"revision": rev, "account": target, "result": "ok", "at": now}
        return
    rec = accounts.get(target)
    name = (rec["oauthAccount"].get("emailAddress") if rec else None) or entry.get("email") or target[:8]
    if rec is None:
        result = f"blocked: {name} is not saved on {me}; needs /login + capture"
    elif login_state(rec, now) in ("needs /login", "login expired"):
        result = f"blocked: {name}'s login on {me} has expired; needs /login + capture"
    else:
        try:
            cmd_switch(paths, state, target, out)
        except AccountError as exc:
            result = f"failed: {exc}"
        else:
            state["history"][-1]["reason"] = f"hub rev {rev}"
            result = "switched"
    print(f"assignment rev {rev}: {result}", file=out)
    state["apply"] = {"revision": rev, "account": target, "result": result, "at": now}


class Hub:
    """The hub's files, under its own lock. Never held across a network call."""

    def __init__(self, paths: Paths):
        self.paths = paths
        self.dir = paths.store / "hub"

    def __enter__(self) -> "Hub":
        init_store(self.paths)
        (self.dir / "reports").mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(self.dir, 0o700)
        fd = os.open(self.dir / "lock", os.O_CREAT | os.O_RDWR, 0o600)
        self.lock = os.fdopen(fd)
        fcntl.flock(self.lock, fcntl.LOCK_EX)
        self.desired = load_json(self.dir / "desired.json")
        self.desired.setdefault("revision", 0)
        for key in ("hosts", "reservations"):
            self.desired.setdefault(key, {})
        self.desired.setdefault("draining", [])
        policy = self.desired.setdefault("policy", {})
        policy.setdefault("critical", list(DEFAULT_CRITICAL))
        return self

    def __exit__(self, *exc) -> None:
        self.lock.close()

    def save(self, change: str | None = None) -> None:
        if change:
            self.desired["revision"] += 1
            self.event("change", change)
        atomic_write(self.dir / "desired.json", self.desired, indent=2)

    def reports(self) -> dict[str, dict]:
        out = {}
        for path in sorted((self.dir / "reports").glob("*.json")):
            try:
                out[path.stem] = load_json(path)
            except (AccountError, ValueError):
                continue
        return out

    def event(self, kind: str, text: str, host: str | None = None, at: int | None = None) -> None:
        path = self.dir / "events.jsonl"
        with open(path, "a") as f:
            f.write(json.dumps({"at": at or int(time.time()), "kind": kind, "host": host,
                                "text": text}) + "\n")
        os.chmod(path, 0o600)
        if path.stat().st_size > 4 * 1024 * 1024:  # keep the newest lines
            lines = path.read_text().splitlines()[-HUB_ALERTS_LIMIT:]
            atomic_write_text(path, "\n".join(lines) + "\n")

    def events(self) -> list[dict]:
        try:
            lines = (self.dir / "events.jsonl").read_text().splitlines()
        except FileNotFoundError:
            return []
        out = []
        for line in lines:
            try:
                out.append(json.loads(line))
            except ValueError:
                continue
        return out


def atomic_write_text(path: Path, text: str) -> None:
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o600)
    os.rename(tmp, path)


def hub_readings(reports: dict[str, dict]) -> dict[str, dict]:
    """Per account, the freshest reading any host reported, with that host."""
    out: dict[str, dict] = {}
    for host, rep in reports.items():
        for uuid, info in ((rep.get("export") or {}).get("accounts") or {}).items():
            reading = info.get("reading") if isinstance(info, dict) else None
            if isinstance(reading, dict) and isinstance(reading.get("at"), (int, float)) \
                    and isinstance(reading.get("limits"), list) \
                    and (uuid not in out or reading["at"] > out[uuid]["at"]):
                out[uuid] = {**reading, "host": host}
    return out


def hub_emails(reports: dict[str, dict]) -> dict[str, str]:
    out = {}
    for rep in reports.values():
        for uuid, info in ((rep.get("export") or {}).get("accounts") or {}).items():
            if isinstance(info, dict) and info.get("email"):
                out[uuid] = info["email"]
    return out


def hub_checkin(hub: Hub, export: dict) -> dict:
    host = export.get("host")
    if not isinstance(host, str) or not PEER_NAME.match(host):
        raise AccountError("check-in without a plain host name")
    if export.get("version") != EXPORT_VERSION or not isinstance(export.get("accounts"), dict):
        raise AccountError(f"{host}: unsupported export")
    now = int(time.time())
    reports = hub.reports()
    previous = (reports.get(host) or {}).get("export") or {}
    seen = set((reports.get(host) or {}).get("events_seen") or [])
    new_events = [e for e in export.get("events") or []
                  if isinstance(e, dict) and e.get("id") not in seen]
    for e in new_events:
        hub.event("alert", str(e.get("message"))[:1000], host=host, at=e.get("at"))
    if previous.get("active") != export.get("active") and previous:
        emails = hub_emails(reports)
        hub.event("active", f"{emails.get(previous.get('active'), previous.get('active'))} -> "
                            f"{emails.get(export.get('active'), export.get('active'))}", host=host)
    if (export.get("apply") or {}) != (previous.get("apply") or {}) and export.get("apply"):
        a = export["apply"]
        hub.event("apply", f"rev {a.get('revision')}: {a.get('result')}", host=host)
    report = {"at": now, "export": export,
              "events_seen": sorted({e.get("id") for e in export.get("events") or []
                                     if isinstance(e, dict) and isinstance(e.get("id"), int)})}
    atomic_write(hub.dir / "reports" / f"{host}.json", report)
    reports[host] = report
    hub_check_low(hub, reports, now)
    d = hub.desired
    return {"version": HUB_VERSION, "revision": d["revision"], "host": host,
            "entry": d["hosts"].get(host), "reservations": d["reservations"],
            "draining": d["draining"], "policy": d["policy"],
            "readings": hub_readings(reports),
            "hosts": {h: {"active": (r.get("export") or {}).get("active"), "at": r.get("at")}
                      for h, r in reports.items()}}


def room_by_account(reports: dict[str, dict], policy: dict, now: float) -> dict[str, tuple[bool, str]]:
    """Every account any host knows: (has room, why) from its freshest reading.
    An account never read counts as having room ("not read yet")."""
    config = {"thresholds": policy.get("thresholds") or {}}
    readings = hub_readings(reports)
    out = {}
    for uuid in hub_emails(reports):
        reading = readings.get(uuid)
        if not reading:
            out[uuid] = (True, "not read yet")
            continue
        over = over_threshold(reading["limits"], config, now, for_switch=True)
        out[uuid] = (not over, ", ".join(f"{limit_name(l)} {l['percent']:.0f}%" for l in over) or "room")
    return out


def hub_check_low(hub: Hub, reports: dict[str, dict], now: float) -> None:
    """Tell Owner when few accounts have room left (Owner's only routine alert)."""
    policy = hub.desired["policy"]
    room = room_by_account(reports, policy, now)
    if not room:
        return
    with_room = sorted(u for u, (ok, _) in room.items() if ok)
    limit = policy.get("low_room_accounts", DEFAULT_LOW_ROOM_ACCOUNTS)
    state = hub.desired.setdefault("low_alert", {})
    if len(with_room) > limit:
        if state:
            hub.desired["low_alert"] = {}
            hub.save()
        return
    if state.get("count") is not None and len(with_room) >= state["count"] \
            and now - state.get("at", 0) < 6 * 3600:
        return
    emails = hub_emails(reports)
    full = "; ".join(f"{emails.get(u, u[:8])} {why}" for u, (ok, why) in sorted(room.items()) if not ok)
    message = (f"Claude accounts running low: {len(with_room)} of {len(room)} have room"
               + (f" ({', '.join(emails.get(u, u[:8]) for u in with_room)})" if with_room else "")
               + f". Full: {full}")
    command = policy.get("notify_command") or str(DEFAULT_NOTIFY)
    scratch: dict = {}
    delivered = notify(scratch, hub.paths, message, command)
    hub.event("owner-alert", message + ("" if delivered else " (NOT delivered)"))
    hub.desired["low_alert"] = {"count": len(with_room), "at": int(now), "delivered": delivered}
    hub.save()


def hub_resolve(reports: dict[str, dict], name: str) -> str:
    emails = hub_emails(reports)
    matches = [u for u, e in emails.items() if e.lower() == name.lower()] \
        or [u for u in emails if u.startswith(name)]
    if len(matches) != 1:
        raise AccountError(f"{name!r} matches {len(matches)} accounts the hosts have reported")
    return matches[0]


def host_accounts(report: dict) -> dict[str, dict]:
    return ((report or {}).get("export") or {}).get("accounts") or {}


def usable_on(report: dict, uuid: str) -> bool:
    info = host_accounts(report).get(uuid)
    return isinstance(info, dict) and info.get("login") not in ("needs /login", "login expired")


def hub_assign(hub: Hub, host: str, account: str | None, mode: str, force: bool) -> str:
    reports = hub.reports()
    if not PEER_NAME.match(host):
        raise AccountError(f"{host!r} is not a plain host name")
    if host not in reports and not force:
        raise AccountError(f"{host} has never checked in; --force to assign anyway")
    hosts = hub.desired["hosts"]
    if account in (None, "none"):
        if hosts.pop(host, None) is None:
            return f"{host} had no assignment"
        hub.save(f"{host}: assignment cleared")
        return f"{host}: assignment cleared (the host keeps its current account, manual)"
    uuid = hub_resolve(reports, account)
    email = hub_emails(reports).get(uuid, uuid[:8])
    if not force:
        res = hub.desired["reservations"].get(uuid)
        if res and host not in res.get("for", []):
            raise AccountError(f"{email} is reserved for {', '.join(res['for']) or 'nobody'}; --force to override")
        if uuid in hub.desired["draining"]:
            raise AccountError(f"{email} is draining; undrain it first or --force")
        if mode == "pin" and not usable_on(reports.get(host), uuid):
            raise AccountError(f"{email} has no valid saved login on {host}; it needs /login + capture "
                               "there first (--force to assign anyway)")
    entry = {"account": uuid, "email": email, "mode": mode, "at": int(time.time())}
    if {k: v for k, v in (hosts.get(host) or {}).items() if k != "at"} == \
            {k: v for k, v in entry.items() if k != "at"}:
        return f"{host}: already {mode} {email}"
    hosts[host] = entry
    hub.save(f"{host}: {mode} {email}")
    return f"{host}: {mode} {email} (rev {hub.desired['revision']}; applies at its next check-in)"


def drain_plan(hub: Hub, uuid: str, now: float) -> list[tuple[str, str | None, str]]:
    """For each host on the account (active or assigned), the best other
    account usable there: most room, fewest hosts already on it."""
    reports = hub.reports()
    d = hub.desired
    readings = hub_readings(reports)
    config = {"thresholds": d["policy"].get("thresholds") or {}}
    on = {}
    for host, rep in reports.items():
        on[host] = (d["hosts"].get(host) or {}).get("account") or (rep.get("export") or {}).get("active")
    load: dict[str, int] = {}
    for acct in on.values():
        if acct:
            load[acct] = load.get(acct, 0) + 1
    plan = []
    for host in sorted(h for h, acct in on.items() if acct == uuid):
        best = None
        for cand in host_accounts(reports[host]):
            if cand == uuid or cand in d["draining"] or not usable_on(reports[host], cand):
                continue
            res = d["reservations"].get(cand)
            if res and host not in res.get("for", []):
                continue
            reading = readings.get(cand)
            if reading and over_threshold(reading["limits"], config, now, for_switch=True):
                continue
            live = [l for l in (reading or {}).get("limits", [])
                    if not (l.get("resets_at") is not None and l["resets_at"] <= now)]
            ratio = max((l["percent"] / threshold_for(l, config) for l in live), default=0.0)
            key = (0 if reading else 1, load.get(cand, 0), ratio, hub_emails(reports).get(cand, cand))
            if best is None or key < best[0]:
                best = (key, cand, "not read yet" if not reading else
                        f"{max(live, key=lambda l: l['percent'] / threshold_for(l, config))['percent']:.0f}% "
                        f"worst limit" if live else "likely refilled")
        if best:
            load[best[1]] = load.get(best[1], 0) + 1
            plan.append((host, best[1], best[2]))
        else:
            plan.append((host, None, "no other usable account with room"))
    return plan


def fmt_reading(reading: dict | None, now: float) -> str:
    return describe_reading(reading, now) if reading else "no reading yet"


def hub_status_view(hub: Hub, now: float) -> dict:
    reports = hub.reports()
    d = hub.desired
    emails = hub_emails(reports)
    readings = hub_readings(reports)
    room = room_by_account(reports, d["policy"], now)
    hosts = {}
    for host in sorted(set(reports) | set(d["hosts"])):
        rep = reports.get(host) or {}
        exp = rep.get("export") or {}
        hosts[host] = {"active": exp.get("active"), "active_email": emails.get(exp.get("active")),
                       "desired": d["hosts"].get(host), "mode": exp.get("mode"),
                       "checked_in_at": rep.get("at"),
                       "stale": not rep or now - rep.get("at", 0) > HUB_REPORT_FRESH_SECONDS,
                       "apply": exp.get("apply"), "sessions": exp.get("sessions"),
                       "saved": sorted(emails.get(u, u) for u in host_accounts(rep) if usable_on(rep, u))}
    accts = {}
    for uuid, email in sorted(emails.items(), key=lambda kv: kv[1]):
        accts[uuid] = {"email": email, "reading": readings.get(uuid),
                       "room": room.get(uuid, (True, ""))[0],
                       "active_on": sorted(h for h, v in hosts.items() if v["active"] == uuid),
                       "saved_on": sorted(h for h, rep in reports.items() if usable_on(rep, uuid)),
                       "reserved_for": (d["reservations"].get(uuid) or {}).get("for"),
                       "reservation_note": (d["reservations"].get(uuid) or {}).get("note"),
                       "draining": uuid in d["draining"]}
    return {"revision": d["revision"], "hosts": hosts, "accounts": accts,
            "critical": d["policy"].get("critical", []),
            "policy": {k: v for k, v in d["policy"].items() if k != "critical"}}


def print_hub_status(view: dict, now: float, out) -> None:
    print(f"hub revision {view['revision']}", file=out)
    print("hosts:", file=out)
    for host, h in view["hosts"].items():
        desired = h["desired"]
        want = f"{desired['mode']} {desired['email']}" if desired else "no assignment (manual)"
        seen = describe_age(now - h["checked_in_at"]) if h["checked_in_at"] else "never"
        stale = " STALE" if h["stale"] else ""
        sessions = f", {h['sessions']['live']} live sessions" if isinstance(h.get("sessions"), dict) else ""
        print(f"  {host:14} on {h['active_email'] or h['active'] or '?'}; wants {want}; "
              f"checked in {seen}{stale}{sessions}", file=out)
        if h["apply"] and h["apply"].get("result") not in ("ok", "switched"):
            print(f"  {'':14} last apply: {h['apply']['result']}", file=out)
    print("accounts:", file=out)
    for uuid, a in view["accounts"].items():
        tags = []
        if a["active_on"]:
            tags.append(f"active on {', '.join(a['active_on'])}")
        if a["reserved_for"] is not None:
            tags.append(f"reserved for {', '.join(a['reserved_for']) or 'nobody'}"
                        + (f" ({a['reservation_note']})" if a["reservation_note"] else ""))
        if a["draining"]:
            tags.append("DRAINING")
        if not a["room"]:
            tags.append("NO ROOM")
        tags.append(f"saved on {', '.join(a['saved_on']) or 'no host'}")
        print(f"  {a['email']:30} {'; '.join(tags)}", file=out)
        print(f"  {'':30} {fmt_reading(a['reading'], now)}", file=out)
    print("critical work (keep running near a limit):", file=out)
    for i, item in enumerate(view["critical"], 1):
        print(f"  {i}. {item}", file=out)


HUB_POLICY_KEYS = {
    "default_mode": (lambda v: v if v in MODES else None),
    "low_room_accounts": (lambda v: int(v) if v.isdigit() else None),
    "notify_command": (lambda v: v or None),
    "coordinator_command": (lambda v: v or None),
}


def cmd_hub(paths: Paths, args, out) -> int:
    now = time.time()
    if args.hub_command == "checkin":
        try:
            export = json.loads(sys.stdin.read())
        except ValueError:
            raise AccountError("check-in input was not JSON") from None
        if not isinstance(export, dict):
            raise AccountError("check-in input was not a JSON object")
        if export.get("host") != args.host:
            raise AccountError("check-in host does not match its export")
        with Hub(paths) as hub:
            reply = hub_checkin(hub, export)
        json.dump(reply, out)
        out.write("\n")
        forward_alerts(paths, export, reply)
        return 0
    with Hub(paths) as hub:
        if args.hub_command == "status":
            view = hub_status_view(hub, now)
            if args.json:
                json.dump(view, out, indent=2)
                out.write("\n")
            else:
                print_hub_status(view, now, out)
            return 0
        if args.hub_command == "assign":
            mode = "auto" if args.auto else "manual" if args.manual else "pin"
            print(hub_assign(hub, args.host, args.account, mode, args.force), file=out)
            return 0
        if args.hub_command in ("reserve", "release"):
            uuid = hub_resolve(hub.reports(), args.account)
            email = hub_emails(hub.reports()).get(uuid, uuid[:8])
            if args.hub_command == "release":
                if hub.desired["reservations"].pop(uuid, None) is None:
                    print(f"{email} was not reserved", file=out)
                    return 0
                hub.save(f"released {email}")
                print(f"released {email}", file=out)
                return 0
            hosts = [] if args.for_hosts == "nobody" else [h for h in args.for_hosts.split(",") if h]
            if not all(PEER_NAME.match(h) for h in hosts):
                raise AccountError("--for takes plain host names, comma-separated, or 'nobody'")
            hub.desired["reservations"][uuid] = {"for": hosts, "note": args.note,
                                                 "at": int(now)}
            hub.save(f"reserved {email} for {', '.join(hosts) or 'nobody'}")
            others = [h for h, e in hub.desired["hosts"].items()
                      if e.get("account") == uuid and h not in hosts]
            print(f"reserved {email} for {', '.join(hosts) or 'nobody'}"
                  + (f"; still assigned to {', '.join(others)}: reassign or drain them" if others else ""),
                  file=out)
            return 0
        if args.hub_command in ("drain", "undrain"):
            uuid = hub_resolve(hub.reports(), args.account)
            email = hub_emails(hub.reports()).get(uuid, uuid[:8])
            if args.hub_command == "undrain":
                if uuid in hub.desired["draining"]:
                    hub.desired["draining"].remove(uuid)
                    hub.save(f"undrained {email}")
                print(f"{email} can take work again", file=out)
                return 0
            plan = drain_plan(hub, uuid, now)
            emails = hub_emails(hub.reports())
            for host, target, why in plan:
                print(f"  {host}: {email} -> {emails.get(target, target) if target else 'stays'} ({why})",
                      file=out)
            if not plan:
                print(f"  no host is on {email}", file=out)
            if args.dry_run:
                print("dry run: nothing changed", file=out)
                return 0
            if uuid not in hub.desired["draining"]:
                hub.desired["draining"].append(uuid)
            for host, target, _ in plan:
                if target:
                    hub.desired["hosts"][host] = {"account": target, "email": emails.get(target, target[:8]),
                                                  "mode": "pin", "at": int(now)}
            hub.save(f"draining {email}: " + ", ".join(
                f"{h} -> {emails.get(t, t) if t else 'stays'}" for h, t, _ in plan))
            stuck = [h for h, t, _ in plan if not t]
            print(f"draining {email} (rev {hub.desired['revision']})"
                  + (f"; no target for {', '.join(stuck)}" if stuck else ""), file=out)
            return 0 if not stuck else 1
        if args.hub_command == "policy":
            policy = hub.desired["policy"]
            if args.key is None:
                for k in HUB_POLICY_KEYS:
                    print(f"{k:22} {policy.get(k, '(default)')}", file=out)
                for k, v in (policy.get("thresholds") or {}).items():
                    print(f"{'thresholds.' + k:22} {v:g}", file=out)
                return 0
            if args.key.startswith("thresholds."):
                kind = args.key.split(".", 1)[1]
                if not re.fullmatch(r"[a-z_]+", kind):
                    raise AccountError(f"{args.key}: not a limit kind")
                th = policy.setdefault("thresholds", {})
                if args.value == "default":
                    th.pop(kind, None)
                else:
                    value = parse_threshold(args.value or "")
                    if value is None:
                        raise AccountError(f"{args.key}: invalid value {args.value!r}")
                    th[kind] = value
                if not th:
                    policy.pop("thresholds")
            elif args.key in HUB_POLICY_KEYS:
                if args.value is None:
                    print(f"{args.key} = {policy.get(args.key, '(default)')}", file=out)
                    return 0
                if args.value == "default":
                    policy.pop(args.key, None)
                else:
                    value = HUB_POLICY_KEYS[args.key](args.value)
                    if value is None:
                        raise AccountError(f"{args.key}: invalid value {args.value!r}")
                    policy[args.key] = value
            else:
                raise AccountError(f"unknown hub policy {args.key!r}")
            hub.save(f"policy {args.key} = {args.value}")
            print(f"{args.key} = {args.value}", file=out)
            return 0
        if args.hub_command == "critical":
            items = hub.desired["policy"].setdefault("critical", [])
            if args.action == "add":
                if not args.text:
                    raise AccountError("critical add needs a description")
                items.append(args.text)
                hub.save(f"critical + {args.text}")
            elif args.action == "remove":
                if not (args.text or "").isdigit() or not 1 <= int(args.text) <= len(items):
                    raise AccountError("critical remove takes the item number shown by `hub critical`")
                gone = items.pop(int(args.text) - 1)
                hub.save(f"critical - {gone}")
            for i, item in enumerate(items, 1):
                print(f"{i}. {item}", file=out)
            return 0
        if args.hub_command in ("history", "alerts"):
            events = hub.events()
            if args.hub_command == "alerts":
                events = [e for e in events if e.get("kind") in ("alert", "owner-alert")]
            if args.since:
                since = parse_time(args.since)
                if since is None:
                    raise AccountError("--since takes an ISO time such as 2026-11-10T06:00Z")
                events = [e for e in events if e.get("at", 0) >= since]
            events = events[-args.n:]
            if args.json:
                json.dump(events, out)
                out.write("\n")
                return 0
            for e in events:
                when = datetime.fromtimestamp(e.get("at", 0), timezone.utc).strftime("%Y-%m-%d %H:%MZ")
                print(f"{when}  {e.get('kind'):11} {e.get('host') or '-':12} {e.get('text')}", file=out)
            return 0
    raise AccountError(f"unknown hub command {args.hub_command}")


def forward_alerts(paths: Paths, export: dict, reply: dict) -> None:
    """Run the policy's coordinator_command once per new alert (best effort),
    so the coordinator wakes instead of waiting for its next look."""
    command = (reply.get("policy") or {}).get("coordinator_command")
    if not command or not export.get("events"):
        return
    for e in export["events"]:
        try:
            subprocess.run([command, f"{export['host']}: {e.get('message')}"], capture_output=True,
                           timeout=30, env=dict(os.environ, CM_NOTIFY_TAG=notify_tag()))
        except (OSError, subprocess.TimeoutExpired):
            pass


# --- commands ------------------------------------------------------------------

def cmd_capture(paths: Paths, state: dict, out) -> int:
    accounts = load_accounts(paths)
    lock, login, uuid, how = identify_locked(paths, accounts)
    with lock:
        profile = read_profile(paths)
        record = save_login(paths, accounts, uuid, login, profile)
        state["active"] = uuid
        persist_state(paths, state)
    record_history(state, "capture", account=uuid, identified_by=how)
    print(f"captured {label(record)}; active", file=out)
    if not profile or profile["accountUuid"] != uuid:
        print(f"warning: {paths.claude_json} names another account; /status may be wrong "
              "until `switch` or `poll` repairs it", file=sys.stderr)
    return 0


def login_state(rec: dict, now: float) -> str:
    expires = rec["claudeAiOauth"].get("refreshTokenExpiresAt")
    if rec.get("needs_login"):
        return "needs /login"
    if isinstance(expires, (int, float)):
        days = (expires / 1000 - now) / 86400
        return f"login valid {days:.0f}d" if days > 0 else "login expired"
    return "login expiry unknown"


def describe_age(seconds: float) -> str:
    if seconds < 3600:
        return f"{seconds / 60:.0f}m ago"
    if seconds < 86400:
        return f"{seconds / 3600:.1f}h ago"
    return f"{seconds / 86400:.1f}d ago"


def cmd_list(paths: Paths, state: dict, out) -> int:
    accounts = load_accounts(paths)
    if not accounts:
        print("no saved accounts; run /login, then `capture`", file=out)
        return 0
    now = time.time()
    for uuid, rec in sorted(accounts.items(), key=lambda kv: label(kv[1])):
        oauth = rec["claudeAiOauth"]
        marker = "*" if uuid == state.get("active") else " "
        age = (now - rec.get("updated_at", now)) / 3600
        print(f"{marker} {label(rec):45} {oauth.get('subscriptionType', '?'):6} "
              f"{login_state(rec, now):20} saved {age:.1f}h ago", file=out)
    return 0


def describe_reading(reading: dict, now: float) -> str:
    parts = []
    for limit in reading["limits"]:
        reset = limit.get("resets_at")
        if reset is not None and reset <= now:
            parts.append(f"{limit_name(limit)} {limit['percent']:.0f}% -> likely refilled")
            continue
        binding = ", binding" if limit.get("active") else ""
        parts.append(f"{limit_name(limit)} {limit['percent']:.0f}% "
                     f"({describe_reset(reset, now)}{binding})")
    source = f" on {reading['host']}" if reading.get("host") else ""
    return f"{'; '.join(parts) or 'no limits reported'}  [read {describe_age(now - reading['at'])}{source}]"


def cmd_status(paths: Paths, state: dict, out, local: bool = False) -> int:
    """Every account's freshest usage reading, from here or a peer host;
    inactive accounts are never polled."""
    accounts = load_accounts(paths)
    if not accounts:
        print("no saved accounts; run /login, then `capture`", file=out)
        return 0
    if not local:
        refresh_peers(state)
    now = time.time()
    config = state.get("config") or {}
    readings = merged_readings(state)
    busy = in_use_elsewhere(state, now)
    excluded = set(config.get("exclude") or [])
    for uuid, rec in sorted(accounts.items(), key=lambda kv: label(kv[1])):
        active = uuid == state.get("active")
        notes = [f"active on {', '.join(busy[uuid])}"] if uuid in busy else []
        if uuid in excluded:
            notes.append("never a switch target")
        print(f"{'*' if active else ' '} {label(rec):45} "
              f"{rec['claudeAiOauth'].get('subscriptionType', '?'):6} {login_state(rec, now)}"
              + "".join(f"; {n}" for n in notes), file=out)
        reading = readings.get(uuid)
        if not reading:
            print("    no usage reading yet" + ("" if active else " (read only while active)"), file=out)
            continue
        print(f"    {describe_reading(reading, now)}", file=out)
    others = {}
    for host, entry in (state.get("peers") or {}).items():
        for uuid, info in ((entry.get("data") or {}).get("accounts") or {}).items():
            if uuid not in accounts and isinstance(info, dict):
                others.setdefault(uuid, (host, info))
    for uuid, (host, info) in sorted(others.items(), key=lambda kv: str(kv[1][1].get("email"))):
        print(f"  {info.get('email') or '?'} ({uuid[:8]}): saved on {host} only, not here", file=out)
        if uuid in readings:
            print(f"    {describe_reading(readings[uuid], now)}", file=out)
    for host, entry in (state.get("peers") or {}).items():
        data = entry.get("data") or {}
        active_email = ((data.get("accounts") or {}).get(data.get("active")) or {}).get("email")
        if entry.get("ok"):
            print(f"peer {host}: active {active_email or data.get('active') or 'none'}", file=out)
        else:
            stale = f"; using its reading from {describe_age(now - entry['at'])}" if entry.get("at") else ""
            error = entry.get("error", "not read")
            error = error[len(host) + 2:] if error.startswith(f"{host}: ") else error
            print(f"peer {host}: {error}{stale}", file=out)
    active = state.get("active")
    readings = state.get("usage") or {}
    if active in accounts and active in readings:
        over = over_threshold(readings[active]["limits"], config, now)
        if over:
            names = ", ".join(f"{limit_name(l)} {l['percent']:.0f}%" for l in over)
            advice = (f". {switch_advice(state, accounts, active, now)}"
                      if over_threshold(over, config, now, for_switch=True) else "")
            print(f"over threshold: {names}{advice}", file=out)
    if config.get("hub"):
        hub = state.get("hub") or {}
        reply = last_hub_reply(state)
        entry = (reply or {}).get("entry")
        want = f"{entry['mode']} {entry.get('email') or entry.get('account')}" if entry else "no assignment (manual)"
        if hub.get("ok"):
            print(f"hub {config['hub']} as {host_name(state)}: checked in {describe_age(now - hub['at'])}, "
                  f"rev {reply.get('revision')}, {want}", file=out)
        else:
            last = f"; last good check-in {describe_age(now - hub['at'])} ({want})" if hub.get("at") else ""
            print(f"hub {config['hub']} as {host_name(state)}: {hub.get('error', 'never checked in')}{last}",
                  file=out)
        applied = state.get("apply")
        if applied:
            print(f"last assignment applied: rev {applied.get('revision')} {applied.get('result')}", file=out)
        if state.get("hub_outbox"):
            print(f"{len(state['hub_outbox'])} alert(s) waiting for the hub", file=out)
    else:
        print(f"autoswitch: {config.get('autoswitch', 'suggest')}", file=out)
    poll = state.get("poll")
    if poll:
        result = "ok" if poll.get("ok") else poll.get("reason", "failed")
        failures = f" ({poll['failures']} failures in a row)" if poll.get("failures") else ""
        print(f"last poll {describe_age(now - poll['at'])}: {result}{failures}", file=out)
    else:
        print("never polled; `poll` runs from the systemd timer", file=out)
    alert = state.get("last_alert")
    if alert:
        sent = "sent" if alert.get("delivered") else f"NOT delivered ({alert.get('error')}); see alerts.log"
        print(f"last alert {describe_age(now - alert['at'])}, {sent}: {alert['message']}", file=out)
    return 0


def poll_usage(paths: Paths, state: dict, accounts: dict[str, dict], out, alert,
               alert_owner) -> tuple[int, list[dict] | None]:
    """Identify the live login (saving a refreshed one) and read its usage, at
    most once per usage interval. Returns (exit code, limits or None)."""
    backoff_until = (state.get("poll") or {}).get("backoff_until", 0)
    if backoff_until > time.time():
        print(f"skipped: backing off after HTTP 429 for another "
              f"{(backoff_until - time.time()) / 60:.0f} min", file=out)
        return 0, None
    login = read_login(paths)
    expires = login.get("expiresAt")
    if isinstance(expires, (int, float)) and expires / 1000 <= time.time():
        print("skipped: the access token has expired; the next prompt in any session renews it",
              file=out)
        return poll_skipped(state, "access token expired"), None
    uuid = next((u for u, rec in accounts.items()
                 if rec["claudeAiOauth"].get("refreshToken") == login["refreshToken"]), None)
    if uuid is None:
        # A session refreshed the token (or someone ran /login): confirm the
        # account and save the new copy, so a later `switch` can identify it.
        try:
            lock, login, uuid, how = identify_locked(paths, accounts)
        except TokenRejected as exc:
            print(f"skipped: {exc}", file=out)
            return poll_skipped(state, "access token rejected"), None
        except RateLimited as exc:
            return poll_rate_limited(state, exc, out), None
        except AccountError as exc:
            return poll_failed(state, str(exc), alert), None
        unsaved = None
        with lock:  # held briefly: alerts may block, so they run after it
            try:
                save_login(paths, accounts, uuid, login, read_profile(paths))
            except AccountError as exc:
                unsaved = exc
        if unsaved:
            entry = state.get("unsaved_alert")
            if not isinstance(entry, dict) or entry.get("account") != uuid:
                entry = None
            if alert_due(entry, time.time()):
                delivered = alert_owner(f"the active login is account {uuid[:8]}, which is not saved; "
                                  "run `cm-claude-accounts capture`")
                state["unsaved_alert"] = {"account": uuid, "at": int(time.time()),
                                          "delivered": delivered}
            return poll_failed(state, str(unsaved), alert), None
        state.pop("unsaved_alert", None)
        record_history(state, "poll-saved-login", account=uuid, identified_by=how)
    if uuid != state.get("active"):
        record_history(state, "external-login", account=uuid)
        state["active"] = uuid
    record = accounts[uuid]
    reading = (state.get("usage") or {}).get(uuid)
    interval = (state.get("config") or {}).get("usage_interval_minutes")
    interval = interval * 60 if isinstance(interval, (int, float)) else USAGE_INTERVAL_SECONDS
    if reading and reading.get("limits") and time.time() - reading["at"] < interval:
        return 0, reading["limits"]  # read recently: spare the endpoint's budget

    try:
        usage = fetch_usage(login["accessToken"])
    except TokenRejected as exc:
        print(f"skipped: {exc}", file=out)
        return poll_skipped(state, "access token rejected"), None
    except RateLimited as exc:
        return poll_rate_limited(state, exc, out), None
    except AccountError as exc:
        return poll_failed(state, str(exc), alert), None
    limits = parse_limits(usage)
    if not limits:
        return poll_failed(state, "the usage response had no limits this tool understands", alert), None

    now = int(time.time())
    previous = state.get("poll") or {}
    if previous.get("failures", 0) >= FAILURE_ALERT_AFTER:
        alert(f"usage poll recovered after {previous['failures']} failures")
    state.setdefault("usage", {})[uuid] = {"at": now, "limits": limits}
    state["poll"] = {"at": now, "ok": True, "account": uuid}

    # Sessions rewrite ~/.claude.json and can restore a stale profile.
    try:
        profile = read_profile(paths)
        if not profile or profile["accountUuid"] != uuid:
            write_profile(paths, record["oauthAccount"])
            record_history(state, "profile-repaired", account=uuid)
            print(f"repaired the profile in {paths.claude_json}", file=out)
    except (AccountError, OSError, ValueError) as exc:
        print(f"warning: could not repair {paths.claude_json} ({exc})", file=sys.stderr)
    return 0, limits


def decide(paths: Paths, state: dict, accounts: dict[str, dict], limits: list[dict],
           mode: str, out, alert) -> bool:
    """Threshold alerts and, in auto, a switch. Returns whether it switched."""
    config = state.get("config") or {}
    now = int(time.time())
    uuid = state["active"]
    record = accounts[uuid]
    advice = None
    over = over_threshold(limits, config, now, for_switch=True)
    if mode == "pin":
        advice = "Pinned by the coordinator; it decides any switch"
    elif over and mode in ("suggest", "auto"):
        refresh_peers(state)  # fresh readings from other hosts before choosing
        target = pick_target(state, accounts, uuid, now)
        dwell = config.get("min_dwell_minutes", DEFAULT_MIN_DWELL_MINUTES) * 60
        since = now - last_switch_at(state)
        cap = config.get("max_auto_switches_per_day", DEFAULT_MAX_AUTO_SWITCHES_PER_DAY)
        held = None
        if mode == "auto" and target:
            if since < dwell:
                held = f"automatic switch waits until {dwell // 60:.0f} min after the last switch"
            elif not target[2] and not config.get("auto_allow_unread"):
                held = ("automatic switch needs a usage reading for the target "
                        "(`config auto_allow_unread true` allows it)")
            elif auto_switches_since(state, now - 86400) >= cap:
                held = f"automatic switches paused: {cap} in the last 24 h"
        if mode == "auto" and target and not held:
            reason = ", ".join(f"{limit_name(l)} {l['percent']:.0f}%" for l in over)
            try:
                cmd_switch(paths, state, target[0], out)
            except AccountError as exc:
                advice = f"Automatic switch failed ({exc}). {switch_advice(state, accounts, uuid, now)}"
            else:
                state["history"][-1]["reason"] = f"auto: {reason}"
                alert(f"{host_name(state)} switched {label(record)} -> {label(accounts[target[0]])} automatically "
                      f"({reason}; target {target[1]})")
                return True
        else:
            advice = switch_advice(state, accounts, uuid, now)
            if held:
                advice += f"; {held}"
    check_limits(state, uuid, record, limits, alert, advice)
    summary = ", ".join(f"{limit_name(l)} {l['percent']:.0f}%" for l in limits)
    read_at = ((state.get("usage") or {}).get(uuid) or {}).get("at")
    if isinstance(read_at, (int, float)) and now - read_at >= 60:
        summary += f" (cached, read {(now - read_at) / 60:.0f}m ago)"
    print(f"{label(record)}: {summary}", file=out)
    return False


CONFIG_KEYS = {
    # key: (parse, describe default)
    "autoswitch": (lambda v: v if v in ("off", "suggest", "auto") else None, "suggest"),
    "min_dwell_minutes": (lambda v: int(v) if v.isdigit() else None, str(DEFAULT_MIN_DWELL_MINUTES)),
    "max_auto_switches_per_day": (lambda v: int(v) if v.isdigit() else None,
                                  str(DEFAULT_MAX_AUTO_SWITCHES_PER_DAY)),
    "auto_allow_unread": (lambda v: {"true": True, "false": False}.get(v), "false"),
    "switch_on_scoped": (lambda v: {"true": True, "false": False}.get(v), "false"),
    "notify_command": (lambda v: v or None, str(DEFAULT_NOTIFY)),
    "hub": (lambda v: v if v == "local" or PEER_NAME.match(v) else None, "none"),
    "host_name": (lambda v: v if PEER_NAME.match(v) else None, "this machine's short hostname"),
    "sweep": (lambda v: {"true": True, "false": False}.get(v), "true"),
    "sweep_owner_sessions": (lambda v: {"true": True, "false": False}.get(v), "false"),
    "usage_interval_minutes": (lambda v: int(v) if v.isdigit() else None, "9"),
    "peers": (lambda v: [h for h in v.split(",") if h] if all(
        PEER_NAME.match(h) for h in v.split(",") if h) else None, "none"),
}


def parse_threshold(value: str):
    try:
        number = float(value)
    except ValueError:
        return None
    return number if 0 < number <= 100 else None


def cmd_config(paths: Paths, state: dict, key: str | None, value: str | None, out) -> int:
    """Show or change state.json "config" under the store lock, so the timer
    never sees a half-written file. VALUE "default" removes the setting."""
    config = state.setdefault("config", {})
    if key is None:
        for name, (_, default) in CONFIG_KEYS.items():
            current = config.get(name)
            shown = (",".join(current) if isinstance(current, list) else json.dumps(current)
                     if isinstance(current, bool) else current)
            print(f"{name:26} {shown if current is not None else default + ' (default)'}", file=out)
        thresholds = {**DEFAULT_THRESHOLDS, **(config.get("thresholds") or {})}
        for kind, pct in thresholds.items():
            note = "" if kind in (config.get("thresholds") or {}) else " (default)"
            print(f"{'thresholds.' + kind:26} {pct:g}{note}", file=out)
        excluded = config.get("exclude") or []
        print(f"{'exclude':26} {len(excluded)} account(s); see `status`", file=out)
        return 0
    if key.startswith("thresholds."):
        kind = key.split(".", 1)[1]
        if not re.fullmatch(r"[a-z_]+", kind):
            raise AccountError(f"{key}: not a limit kind (session, weekly, weekly_all, ...)")
        parse = parse_threshold
    elif key in CONFIG_KEYS:
        parse = CONFIG_KEYS[key][0]
    else:
        raise AccountError(f"unknown setting {key!r}; run `config` to list them")
    if value is None:
        current = (config.get("thresholds") or {}).get(key.split(".", 1)[1]) \
            if key.startswith("thresholds.") else config.get(key)
        print(f"{key} = {json.dumps(current) if current is not None else '(default)'}", file=out)
        return 0
    if value == "default":
        parsed = None
    else:
        parsed = parse(value)
        if parsed is None:
            raise AccountError(f"{key}: invalid value {value!r}")
    if key.startswith("thresholds."):
        thresholds = config.setdefault("thresholds", {})
        thresholds.pop(key.split(".", 1)[1], None) if parsed is None \
            else thresholds.__setitem__(key.split(".", 1)[1], parsed)
        if not thresholds:
            config.pop("thresholds")
    elif parsed is None:
        config.pop(key, None)
    else:
        config[key] = parsed
    if key == "peers":
        refresh_peers(state)  # drops cached peers no longer listed
    record_history(state, "config", key=key, value=value)
    print(f"{key} = {value}", file=out)
    if key == "autoswitch" and value == "auto":
        print("note: poll now moves every session on this host on its own when the active "
              "account crosses a threshold", file=out)
    return 0


def cmd_exclude(paths: Paths, state: dict, name: str, exclude: bool, out) -> int:
    accounts = load_accounts(paths)
    uuid = resolve(accounts, name)
    config = state.setdefault("config", {})
    excluded = [u for u in config.get("exclude") or [] if u != uuid]
    if exclude:
        excluded.append(uuid)
    if excluded:
        config["exclude"] = sorted(excluded)
    else:
        config.pop("exclude", None)
    record_history(state, "exclude" if exclude else "include", account=uuid)
    print(f"{label(accounts[uuid])} " + ("will never be a switch target" if exclude
                                         else "can be a switch target again"), file=out)
    return 0


def cmd_history(paths: Paths, state: dict, limit: int, out) -> int:
    accounts = load_accounts(paths)

    def name(uuid):
        return label(accounts[uuid]) if uuid in accounts else str(uuid)[:8]

    events = state.get("history") or []
    if not events:
        print("no history yet", file=out)
    for h in events[-limit:]:
        when = datetime.fromtimestamp(h.get("at", 0), timezone.utc).strftime("%Y-%m-%d %H:%MZ")
        text = h.get("event", "?")
        if "previous" in h:
            text += f" {name(h['previous'])} ->"
        if "account" in h:
            text += f" {name(h['account'])}"
        if "key" in h:
            text += f" {h['key']} = {h.get('value')}"
        if h.get("reason"):
            text += f" ({h['reason']})"
        print(f"{when}  {text}", file=out)
    return 0


UNITS = ("cm-claude-accounts-poll.service", "cm-claude-accounts-poll.timer")


def systemctl(*args: str) -> None:
    subprocess.run(["systemctl", "--user", *args], check=True)


def cmd_install(out, timer: bool = True) -> int:
    """Copy this script to ~/.local/bin and (optionally) start the poll timer.
    Run from a checkout. Starting the timer also saves this host's current
    login on the next poll, as `capture` would."""
    source = Path(__file__).resolve()
    deploy = source.parent.parent / "deploy"
    if not all((deploy / unit).is_file() for unit in UNITS):
        raise AccountError(f"run install from a claude-manager checkout ({deploy} has no units)")
    home = Path.home()
    target = home / ".local/bin/cm-claude-accounts"
    target.parent.mkdir(parents=True, exist_ok=True)
    tmp = target.with_name(f".{target.name}.new")
    shutil.copyfile(source, tmp)
    os.chmod(tmp, 0o755)
    os.replace(tmp, target)
    print(f"installed {target}", file=out)
    if not timer:
        return 0
    units = home / ".config/systemd/user"
    units.mkdir(parents=True, exist_ok=True)
    for unit in UNITS:
        shutil.copyfile(deploy / unit, units / unit)
        os.chmod(units / unit, 0o644)
    try:
        systemctl("daemon-reload")
        systemctl("enable", "--now", UNITS[1])
    except (OSError, subprocess.CalledProcessError) as exc:
        raise AccountError(f"units copied, but systemctl failed ({exc})") from None
    print(f"timer enabled: {UNITS[1]} (poll every 2 min; usage read every ~10 min)", file=out)
    return 0


def cmd_poll(paths: Paths, state: dict, out, notify_command: str) -> int:
    """Read the active account's usage, keep its saved login current, alert,
    check in with the hub and apply its assignment.

    Never refreshes a token and never polls an inactive account's saved one.
    """
    def alert_owner(message: str) -> bool:
        print(f"alert: {message}", file=out)
        return notify(state, paths, message, notify_command)

    def alert(message: str) -> bool:
        """With a hub, routine alerts go to the coordinator, not Owner."""
        if not (state.get("config") or {}).get("hub"):
            return alert_owner(message)
        print(f"to coordinator: {message}", file=out)
        log_alert(paths, f"(to coordinator) {message}")
        seq = state.get("hub_outbox_seq", 0) + 1
        state["hub_outbox_seq"] = seq
        state.setdefault("hub_outbox", []).append({"id": seq, "at": int(time.time()), "message": message})
        del state["hub_outbox"][:-HUB_OUTBOX_LIMIT]
        return True

    accounts = load_accounts(paths)
    if not accounts:
        print("no saved accounts; nothing to poll", file=out)
        hub_exchange(paths, state, out)
        return 0
    check_logins(state, accounts, alert_owner)
    code, limits = poll_usage(paths, state, accounts, out, alert, alert_owner)
    mode = effective_mode(state)
    if limits is not None and state.get("active") in accounts:
        decide(paths, state, accounts, limits, mode, out, alert)
    sweep(paths, state, out, alert, alert_owner)  # also counts live sessions for the report
    reply = hub_exchange(paths, state, out)
    if reply is not None:
        apply_assignment(paths, state, load_accounts(paths), reply, out)
    return code


def cmd_switch(paths: Paths, state: dict, target_name: str, out) -> int:
    accounts = load_accounts(paths)
    target = resolve(accounts, target_name)
    lock, login, current, how = identify_locked(paths, accounts)
    with lock:
        save_login(paths, accounts, current, login, read_profile(paths))
        if current != state.get("active"):
            record_history(state, "external-login", account=current, identified_by=how)
        state["active"] = current
        record = accounts[target]
        if current != target:
            expires = record["claudeAiOauth"].get("refreshTokenExpiresAt")
            if isinstance(expires, (int, float)) and expires / 1000 <= time.time():
                record["needs_login"] = True
                save_account(paths, record)
                raise AccountError(f"{label(record)}'s saved login has expired; "
                                   "run /login for it, then `capture`")
            lock.touch()
            creds = load_json(paths.credentials)
            creds["claudeAiOauth"] = record["claudeAiOauth"]
            write_in_place(paths.credentials, creds)
            # The file now holds the target's tokens: record that before
            # anything else can fail, or the next refresh is misattributed.
            state["active"] = target
            record_history(state, "switch", account=target, previous=current, identified_by=how)
        persist_state(paths, state)
        if time.monotonic() - lock.acquired_at > MAX_HOLD_SECONDS:
            print("warning: refresh lock held longer than expected", file=sys.stderr)
    # Identity is confirmed, so repairing the display profile is safe.
    try:
        profile = read_profile(paths)
        if not profile or profile["accountUuid"] != target:
            write_profile(paths, record["oauthAccount"])
    except (AccountError, OSError, ValueError) as exc:
        print(f"warning: login switched, but {paths.claude_json} was not updated ({exc}); "
              "/status may show the previous account", file=sys.stderr)
    if current == target:
        print(f"already on {label(record)}", file=out)
    else:
        print(f"switched {label(accounts[current])} -> {label(record)}", file=out)
    return 0


def run_login_session(paths: Paths, out, claude_command: str = "claude") -> Path:
    """Run Claude Code in a private scratch config directory so /login there
    never touches this host's own login (its sessions keep running). Runs
    without the store lock: it waits on a person."""
    scratch = paths.store / "login-scratch"
    init_store(paths)
    shutil.rmtree(scratch, ignore_errors=True)
    scratch.mkdir(mode=0o700)
    print("Claude Code is starting in a scratch directory; this host's sessions are not affected.\n"
          "Type /login, sign in as the account to add, then /exit.", file=out)
    out.flush()
    try:
        subprocess.run([claude_command], env=dict(os.environ, CLAUDE_CONFIG_DIR=str(scratch)))
    except OSError as exc:
        shutil.rmtree(scratch, ignore_errors=True)
        raise AccountError(f"could not start {claude_command} ({type(exc).__name__})") from None
    return scratch


def cmd_login_save(paths: Paths, state: dict, scratch: Path, out) -> int:
    """Save the scratch directory's login, then delete the scratch copy."""
    try:
        scratch_paths = Paths(scratch, scratch / ".claude.json", paths.store)
        try:
            login = read_login(scratch_paths)
        except AccountError:
            raise AccountError("no login was made in the scratch session; run `login` again "
                               "and type /login there") from None
        accounts = load_accounts(paths)
        uuid, how = identify(login, accounts)
        if uuid == state.get("active"):
            raise AccountError(f"{label(accounts[uuid])} is already this host's active login; "
                               "nothing saved (its live copy stays authoritative)")
        record = save_login(paths, accounts, uuid, login, read_profile(scratch_paths))
        record_history(state, "login", account=uuid, identified_by=how)
        print(f"saved {label(record)}; this host stays on its current account", file=out)
        return 0
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def cmd_remove(paths: Paths, state: dict, name: str, out) -> int:
    accounts = load_accounts(paths)
    uuid = resolve(accounts, name)
    if uuid == state.get("active"):
        raise AccountError("cannot remove the active account; switch away first")
    (paths.accounts / f"{uuid}.json").unlink()
    record_history(state, "remove", account=uuid)
    print(f"removed {label(accounts[uuid])}", file=out)
    return 0


def main(argv: list[str] | None = None, paths: Paths | None = None, out=None) -> int:
    paths = paths or Paths.default()
    out = out or sys.stdout
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("capture", help="save the current login (run right after /login)")
    sub.add_parser("list", help="saved accounts; * marks the active one")
    status = sub.add_parser("status", help="every account's freshest usage reading (here or on "
                            "a peer host), poll health, last alert")
    status.add_argument("--local", action="store_true", help="skip reading peer hosts")
    sub.add_parser("export", help="this host's accounts and readings as JSON, no tokens "
                   "(peers read it over ssh)")
    config = sub.add_parser("config", help="show or change settings (VALUE 'default' resets one)")
    config.add_argument("key", nargs="?")
    config.add_argument("value", nargs="?")
    for name, verb in (("exclude", "never switch to an account"),
                       ("include", "undo exclude")):
        p = sub.add_parser(name, help=verb)
        p.add_argument("account", help="email or accountUuid prefix")
    history = sub.add_parser("history", help="recent switches and other events")
    history.add_argument("-n", type=int, default=20)
    hub = sub.add_parser("hub", help="the coordinator's control plane (run on the hub host)")
    hsub = hub.add_subparsers(dest="hub_command", required=True)
    p = hsub.add_parser("checkin", help="(hosts run this over ssh) report and get the assignment")
    p.add_argument("host")
    p = hsub.add_parser("status", help="every host and account")
    p.add_argument("--json", action="store_true")
    p = hsub.add_parser("assign", help="choose a host's account; ACCOUNT 'none' clears it")
    p.add_argument("host")
    p.add_argument("account")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--pin", action="store_true", help="switch to it and stay (default)")
    g.add_argument("--auto", action="store_true", help="the host may switch itself at threshold")
    g.add_argument("--manual", action="store_true", help="never switch; suggest only")
    p.add_argument("--force", action="store_true")
    p = hsub.add_parser("reserve", help="keep an account for named hosts")
    p.add_argument("account")
    p.add_argument("--for", dest="for_hosts", required=True, help="host[,host...] or 'nobody'")
    p.add_argument("--note")
    p = hsub.add_parser("release", help="undo reserve")
    p.add_argument("account")
    p = hsub.add_parser("drain", help="move every host off an account and keep work off it")
    p.add_argument("account")
    p.add_argument("--dry-run", action="store_true")
    p = hsub.add_parser("undrain", help="let an account take work again")
    p.add_argument("account")
    p = hsub.add_parser("policy", help="show or set hub policy (VALUE 'default' resets)")
    p.add_argument("key", nargs="?")
    p.add_argument("value", nargs="?")
    p = hsub.add_parser("critical", help="the critical-work list: list | add TEXT | remove N")
    p.add_argument("action", nargs="?", choices=("list", "add", "remove"), default="list")
    p.add_argument("text", nargs="?")
    for name in ("history", "alerts"):
        p = hsub.add_parser(name, help="hub events" if name == "history" else "alerts hosts sent the coordinator")
        p.add_argument("-n", type=int, default=50)
        p.add_argument("--since")
        p.add_argument("--json", action="store_true")
    login = sub.add_parser("login", help="add an account without moving this host: /login in a "
                           "scratch Claude session, then save it")
    login.add_argument("--claude-command", default="claude", help=argparse.SUPPRESS)
    install = sub.add_parser("install", help="copy to ~/.local/bin and start the poll timer "
                             "(run from a checkout)")
    install.add_argument("--no-timer", action="store_true")
    poll = sub.add_parser("poll", help="read the active account's usage and alert (run by the timer)")
    test_alert = sub.add_parser("test-alert", help="send a test alert through the notifier")
    for p in (poll, test_alert):
        p.add_argument("--notify-command", help=f"alert command (default {DEFAULT_NOTIFY}, "
                       "or config.notify_command in state.json)")
    switch = sub.add_parser("switch", help="make another saved account active")
    switch.add_argument("account", help="email or accountUuid prefix")
    remove = sub.add_parser("remove", help="delete a saved account")
    remove.add_argument("account")
    args = parser.parse_args(argv)
    if args.command == "install":
        try:
            return cmd_install(out, timer=not args.no_timer)
        except (AccountError, OSError) as exc:
            print(f"cm-claude-accounts: {exc}", file=sys.stderr)
            return 1
    if args.command == "hub":
        # The hub has its own lock; a host's check-in must not wait on the
        # hub host's own poll.
        try:
            return cmd_hub(paths, args, out)
        except (AccountError, OSError, ValueError, KeyError) as exc:
            print(f"cm-claude-accounts: {exc}", file=sys.stderr)
            return 1
    scratch = None
    if args.command == "login":
        try:
            scratch = run_login_session(paths, out, args.claude_command)
        except (AccountError, OSError) as exc:
            print(f"cm-claude-accounts: {exc}", file=sys.stderr)
            return 1
    if args.command == "export":
        # No store lock: two hosts reading each other while each holds its
        # own lock would wait on each other. state.json is replaced
        # atomically, so an unlocked read is consistent.
        try:
            json.dump(export_view(paths, load_json(paths.state)), out)
            out.write("\n")
            return 0
        except (AccountError, OSError, ValueError, KeyError) as exc:
            print(f"cm-claude-accounts: {exc}", file=sys.stderr)
            return 1
    try:
        init_store(paths)
        fd = os.open(paths.store / "lock", os.O_CREAT | os.O_RDWR, 0o600)
        with os.fdopen(fd) as store_lock:
            fcntl.flock(store_lock, fcntl.LOCK_EX)
            state = load_json(paths.state)
            try:
                if args.command == "capture":
                    return cmd_capture(paths, state, out)
                if args.command == "login":
                    return cmd_login_save(paths, state, scratch, out)
                if args.command == "list":
                    return cmd_list(paths, state, out)
                if args.command == "status":
                    return cmd_status(paths, state, out, local=args.local)
                if args.command == "config":
                    return cmd_config(paths, state, args.key, args.value, out)
                if args.command in ("exclude", "include"):
                    return cmd_exclude(paths, state, args.account, args.command == "exclude", out)
                if args.command == "history":
                    return cmd_history(paths, state, args.n, out)
                if args.command in ("poll", "test-alert"):
                    notify_command = (args.notify_command
                                      or (state.get("config") or {}).get("notify_command")
                                      or str(DEFAULT_NOTIFY))
                    if args.command == "poll":
                        return cmd_poll(paths, state, out, notify_command)
                    notify(state, paths, "test alert from cm-claude-accounts", notify_command)
                    delivered = state["last_alert"]["delivered"]
                    print("test alert sent" if delivered else
                          f"test alert NOT delivered ({state['last_alert']['error']})", file=out)
                    return 0 if delivered else 1
                if args.command == "switch":
                    return cmd_switch(paths, state, args.account, out)
                return cmd_remove(paths, state, args.account, out)
            finally:
                # Keep what was learned (write-back, needs_login) even on refusal.
                persist_state(paths, state)
    except (AccountError, OSError, ValueError, KeyError) as exc:
        # Messages name accounts and files only, never token values.
        print(f"cm-claude-accounts: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())

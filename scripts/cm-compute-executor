#!/usr/bin/env python3
"""Standalone lease action executor. Run only on a host with the approved IAP route."""
import json
import logging
import os
import re
import shlex
import subprocess
import time
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

LOG = logging.getLogger('cm-compute-executor')
_last_queue_inventory = None


def api(path, data):
    base = os.environ['CM_API_URL'].rstrip('/')
    req = urllib.request.Request(base + path, data=json.dumps(data).encode(), method='POST',
        headers={'Authorization': 'Bearer ' + os.environ['CM_API_TOKEN'], 'Content-Type': 'application/json'})
    with urllib.request.urlopen(req, timeout=20) as response:
        return json.load(response)


def command_for(action):
    payload = action['payload']
    ident = str(action['lease_id'])
    args = ['sudo', '-n', '/usr/local/bin/cm-lease', action['kind'], '--lease-id', ident]
    if action['kind'] == 'grant':
        args += ['--owner', payload['owner'], '--slots', str(payload['slots']),
                 '--mem-gb', str(payload['mem_gb']), '--expires-epoch', str(payload['expires_epoch'])]
        if payload.get('pin'):
            args += ['--pin', payload['pin']]
    elif action['kind'] == 'extend':
        args += ['--expires-epoch', str(payload['expires_epoch'])]
    elif action['kind'] != 'release':
        raise ValueError('unknown action')
    return shlex.join(args)


def execute(action, routes):
    route = routes[action['payload']['box']]
    # Routes are configured locally, not supplied by an agent or the API.
    command = [*route['argv'], '--command', command_for(action)]
    try:
        completed = subprocess.run(command, check=True, text=True, capture_output=True, timeout=90)
    except subprocess.CalledProcessError as exc:
        if action['kind'] == 'grant' and exc.returncode == 3:
            for line in reversed((exc.stderr or '').splitlines()):
                try:
                    error = json.loads(line)
                except ValueError:
                    continue
                if (isinstance(error, dict) and error.get('refused') is True and
                        isinstance(error.get('error'), str) and error['error'].strip()):
                    return {'lease_id': str(action['lease_id']), 'refused': True, 'error': error['error']}
                if (isinstance(error, dict) and error.get('refused') is False and
                        isinstance(error.get('error'), str) and error['error'].strip()):
                    # This may follow a partial node operation: retain the
                    # reservation and claimed action, but record the reason.
                    return {'lease_id': str(action['lease_id']), 'retryable': True, 'error': error['error']}
        if action['kind'] != 'extend':
            raise
        # A failed SSH command says nothing about node state. A separate,
        # successful, locked node probe must prove record and slice absence.
        probe = shlex.join(['sudo', '-n', '/usr/local/bin/cm-lease', 'probe',
                            '--lease-id', str(action['lease_id'])])
        checked = subprocess.run([*route['argv'], '--command', probe], check=True,
                                 text=True, capture_output=True, timeout=90)
        evidence = json.loads(checked.stdout)
        if (evidence.get('lease_id') != str(action['lease_id']) or
                evidence.get('exists') is not False or evidence.get('unit_inactive') is not True):
            raise ValueError('node did not confirm lease absence')
        return {'lease_id': str(action['lease_id']), 'absent': True, 'unit_inactive': True}
    result = json.loads(completed.stdout)
    if result.get('lease_id') != str(action['lease_id']):
        raise ValueError('node result does not match lease')
    return result


def local_drained(box, directory):
    directory = Path(directory)
    if not directory.is_dir():
        return False
    listing = subprocess.run(['ps', '-eo', 'args='], check=True, text=True,
                             capture_output=True, timeout=10).stdout
    # Mirror lq_busy's own driver discovery; a missing/unreadable candidate
    # cannot be treated as evidence of an empty pool.
    for name in set(re.findall(r'\bbash ([A-Za-z0-9_]+\.sh)\b', listing)):
        script = directory / name
        if not script.exists():
            continue
        content = script.read_text(errors='strict')
        if re.search(r'\blane_run_' + re.escape(box) + r'\b', content):
            return False
    return True


def enable_drained_boxes(cfg, enabled):
    global _last_queue_inventory
    if cfg.get('cutover_ready') is not True:
        return
    try:
        queued = api('/compute/executor/pre-enable', {})
        if (not isinstance(queued, dict) or type(queued.get('queued_count')) is not int
                or queued['queued_count'] < 0 or not isinstance(queued.get('queued'), list)
                or not isinstance(queued.get('enabled_boxes'), list)
                or type(queued.get('has_ever_enabled')) is not bool
                or not isinstance(queued.get('quarantined_boxes'), list)
                or any(not isinstance(name, str) or not name for name in queued['quarantined_boxes'])
                or any(not isinstance(name, str) or not name for name in queued['enabled_boxes'])
                or queued['queued_count'] != len(queued['queued'])):
            raise ValueError('invalid pre-enable queue response')
        inventory = json.dumps(queued['queued'], sort_keys=True)
        if not queued['has_ever_enabled'] and inventory != _last_queue_inventory:
            LOG.info('pre-enable queue count=%s rows=%s', queued['queued_count'], inventory)
            _last_queue_inventory = inventory
        if queued['queued_count'] and not queued['has_ever_enabled'] and cfg.get('allow_queued_at_cutover') is not True:
            LOG.warning('keeping boxes disabled until queued requests are reviewed')
            return
    except (OSError, ValueError, KeyError, urllib.error.URLError):
        LOG.exception('pre-enable queue check failed; keeping boxes disabled')
        return
    for box, route in cfg['routes'].items():
        try:
            if box in enabled or box in queued['quarantined_boxes'] or not local_drained(box, cfg['lq_directory']):
                continue
            remote = subprocess.run([*route['argv'], '--command',
                                     'sudo -n /usr/local/bin/cm-lease drain-check'],
                                    check=True, text=True, capture_output=True, timeout=90)
            evidence = json.loads(remote.stdout)
            if evidence.get('drained') is True:
                api('/compute/executor/enable', {'box': box, 'local_drained': True,
                                                  'node_drained': True,
                                                  'node_max_slots': evidence.get('max_slots')})
                enabled.add(box)
        except (OSError, ValueError, KeyError, subprocess.SubprocessError, urllib.error.URLError):
            LOG.exception('box %s remains disabled', box)


def sample_leases(cfg):
    def sample_one(target):
        route = cfg['routes'][target['box']]
        command = shlex.join(['sudo', '-n', '/usr/local/bin/cm-lease', 'status',
                              '--lease-id', str(target['lease_id'])])
        try:
            completed = subprocess.run([*route['argv'], '--command', command], check=True,
                                       text=True, capture_output=True, timeout=90)
            result = json.loads(completed.stdout)
            if result.get('lease_id') != str(target['lease_id']):
                raise ValueError('sample lease mismatch')
            api('/compute/executor/sample', {'lease_id': target['lease_id'],
                                             'cpu_usage_usec': result['cpu_usage_usec']})
        except (OSError, ValueError, KeyError, subprocess.SubprocessError, urllib.error.URLError):
            # Missing measurements are not evidence of idleness.
            LOG.exception('could not sample lease %s', target['lease_id'])
    targets = api('/compute/executor/samples', {})['leases']
    with ThreadPoolExecutor(max_workers=cfg['sample_parallelism']) as pool:
        list(pool.map(sample_one, targets))


def main():
    logging.basicConfig(level=logging.INFO)
    cfg = json.loads(Path(os.environ['CM_COMPUTE_EXECUTOR_CONFIG']).read_text())
    enabled = set()
    next_sample = 0.0
    next_enable = 0.0
    workers = ThreadPoolExecutor(max_workers=2, thread_name_prefix='compute')
    sample_future = None
    enable_future = None
    while True:
        try:
            if sample_future is not None and sample_future.done():
                completed = sample_future
                sample_future = None
                completed.result()
            if enable_future is not None and enable_future.done():
                completed = enable_future
                enable_future = None
                completed.result()
            if time.monotonic() >= next_enable and (enable_future is None or enable_future.done()):
                enable_future = workers.submit(enable_drained_boxes, cfg, enabled)
                next_enable = time.monotonic() + cfg['enable_retry_seconds']
            if time.monotonic() >= next_sample and (sample_future is None or sample_future.done()):
                sample_future = workers.submit(sample_leases, cfg)
                next_sample = time.monotonic() + cfg['sample_seconds']
            action = api('/compute/executor/poll', {})['action']
            if action:
                result = execute(action, cfg['routes'])
                api('/compute/executor/complete', {'action_id': action['action_id'], 'result': result})
                continue
        except (OSError, ValueError, KeyError, subprocess.SubprocessError, urllib.error.URLError):
            # An uncertain result is retried with the same action ID. Never
            # acknowledge an action merely because the transport returned.
            LOG.exception('lease action failed; retaining reservation')
        time.sleep(cfg['poll_seconds'])


if __name__ == '__main__':
    main()

#!/usr/bin/env python3
"""Privileged node-side lease operations; configuration is required.

This program is installed root-owned and called through a narrowly scoped
sudoers entry. It deliberately never accepts an arbitrary unit name or path.
"""
import argparse
import fcntl
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import time
import uuid
from pathlib import Path

CONFIG = Path('/etc/cm-lease.json')
STATE = Path('/run/cm-lease')
LOG = Path('/var/log/cm-lease.log')


class Refused(Exception):
    pass


def lease_id(value):
    try:
        canonical = str(uuid.UUID(value))
    except ValueError as exc:
        raise argparse.ArgumentTypeError('expected a UUID') from exc
    if value != canonical:
        raise argparse.ArgumentTypeError('expected a canonical UUID')
    return canonical


def config():
    # The sudo boundary must not read user-controlled config or follow a link.
    st = CONFIG.lstat()
    if not CONFIG.is_file() or CONFIG.is_symlink() or st.st_uid != 0 or st.st_mode & 0o022:
        raise Refused('config must be root-owned, non-symlink and not group/world writable')
    data = json.loads(CONFIG.read_text())
    for k in ('max_slots', 'cpus_per_slot', 'mem_gb_per_slot', 'max_duration_seconds', 'user'):
        if k not in data:
            raise Refused('missing config key ' + k)
    if any(not isinstance(data[k], int) or isinstance(data[k], bool) or data[k] <= 0
           for k in ('max_slots', 'cpus_per_slot', 'mem_gb_per_slot', 'max_duration_seconds')):
        raise Refused('invalid numeric config')
    # A broken workdir must not prevent status, expiry or release. Grant and
    # cleanup validate it again before using it.
    try:
        data['workdir_root'] = str(workdir_root(data))
    except Refused:
        pass
    return data


def drain_ignore_datadirs(cfg):
    ignored = cfg.get('drain_ignore_datadirs', [])
    if (not isinstance(ignored, list) or any(not isinstance(path, str) or
            not path or '\0' in path or not os.path.isabs(path) for path in ignored)):
        raise Refused('drain_ignore_datadirs must be a list of absolute paths')
    return ignored


def disk_policy(cfg):
    result = {}
    for key, default in (('owner_dir_cap_gb', 20), ('min_free_gb', 15)):
        value = cfg.get(key, default)
        if not isinstance(value, int) or isinstance(value, bool) or value <= 0:
            raise Refused(f'{key} must be a positive integer')
        result[key] = value
    return result


def require_free_space(cfg):
    floor = disk_policy(cfg)['min_free_gb'] * 1024 ** 3
    free = shutil.disk_usage('/home').free
    if free < floor:
        raise Refused(f'insufficient free space on /home: {free} bytes available; minimum {floor}')


def workdir_root(cfg):
    try:
        root = Path(cfg['workdir_root'])
        if not root.is_absolute() or not root.is_dir() or any(p.is_symlink() for p in (root, *root.parents)):
            raise Refused('workdir_root must be an existing absolute directory without symlink ancestors')
        return root.resolve(strict=True)
    except (KeyError, TypeError, ValueError, OSError, RuntimeError) as exc:
        raise Refused('invalid workdir_root: ' + str(exc)) from exc


def run(*args):
    return subprocess.run(args, check=True, text=True, capture_output=True).stdout.strip()


def record_path(ident):
    return STATE / (ident + '.json')


def load(ident):
    try:
        return json.loads(record_path(ident).read_text())
    except FileNotFoundError:
        return None


def save(ident, value):
    path = record_path(ident)
    tmp = path.with_suffix('.tmp')
    with tmp.open('w') as f:
        json.dump(value, f, sort_keys=True)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def unit(ident):
    return f'cmlease-{uuid.UUID(ident).hex}.slice'


def audit(action, ident, detail=None):
    with LOG.open('a') as f:
        entry = {'time': int(time.time()), 'action': action, 'lease_id': ident}
        if detail is not None:
            entry['detail'] = detail
        f.write(json.dumps(entry) + '\n')


def create_workdir(path, owner, ident, expires, user):
    # The parent lives under a shared user's home. Never create or write a
    # user-controlled path as root: a concurrent rename/symlink must not turn
    # this sudo entry into a privileged file-write primitive.
    code = '''import hashlib, json, os, pathlib, sys, time
p = pathlib.Path(sys.argv[1])
p.mkdir(mode=0o700, exist_ok=False)
fd = os.open(p / "OWNER.md", os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
content = ("owner: %s\\nlease: %s\\ncreated: %s\\nexpires: %s\\ndelete-after: release, after owner review\\n" % (sys.argv[2], sys.argv[3], int(time.time()), sys.argv[4])).encode()
with os.fdopen(fd, "wb") as f:
    f.write(content)
    f.flush()
    info = os.fstat(f.fileno())
print(json.dumps({"device": info.st_dev, "inode": info.st_ino, "sha256": hashlib.sha256(content).hexdigest()}))
'''
    output = run('/usr/sbin/runuser', '-u', user, '--', '/usr/bin/python3', '-c', code,
                 str(path), owner, ident, str(expires))
    return json.loads(output)


def workdir_size_and_remove_if_empty(path, user, owner_marker):
    # Like creation, cleanup is performed with the owning user's credentials.
    if not path.exists():
        return 0
    out = run('/usr/sbin/runuser', '-u', user, '--', '/usr/bin/du', '-sb', '--', str(path))
    # The marker is removed only when it is the same regular file and still
    # has exactly the contents created for this lease. Run as the lease user.
    code = '''import hashlib, json, os, pathlib, stat, sys
p = pathlib.Path(sys.argv[1])
marker = json.loads(sys.argv[2])
try:
    fd = os.open(p / "OWNER.md", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as f:
        info = os.fstat(f.fileno())
        if (marker and stat.S_ISREG(info.st_mode) and info.st_dev == marker.get("device")
                and info.st_ino == marker.get("inode") and info.st_size <= 65536
                and hashlib.sha256(f.read()).hexdigest() == marker.get("sha256")
                and set(os.listdir(p)) == {"OWNER.md"}):
            (p / "OWNER.md").unlink()
except OSError:
    pass
try:
    p.rmdir()
except OSError:
    pass
'''
    run('/usr/sbin/runuser', '-u', user, '--', '/usr/bin/python3', '-c', code,
        str(path), json.dumps(owner_marker))
    return int(out.split()[0])


def refresh_retained_owner(path, row, ident):
    # Do not replace a file the owner changed or a symlink. Recreate only a
    # missing marker or replace the exact generated marker, as the lease user.
    code = """import hashlib, json, os, pathlib, stat, sys, time
p = pathlib.Path(sys.argv[1]); marker = json.loads(sys.argv[2] or 'null')
target = p / 'OWNER.md'
if not p.is_dir():
    sys.exit(0)
try:
    fd = os.open(target, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
except FileNotFoundError:
    pass
else:
    with os.fdopen(fd, 'rb') as f:
        info = os.fstat(f.fileno())
        if (not marker or not stat.S_ISREG(info.st_mode) or info.st_size > 65536 or
            info.st_dev != marker.get('device') or info.st_ino != marker.get('inode') or
            hashlib.sha256(f.read()).hexdigest() != marker.get('sha256')):
            raise RuntimeError('OWNER.md changed; cannot refresh safely')
    target.unlink()
fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
with os.fdopen(fd, 'w') as f:
    f.write('owner: %s\\nlease: %s\\nreleased: %s\\nkeep: retained lease files\\ndelete-after: owner review\\n' % (sys.argv[3], sys.argv[4], int(time.time())))
"""
    run('/usr/sbin/runuser', '-u', row['user'], '--', '/usr/bin/python3', '-c', code,
        str(path), json.dumps(row.get('owner_marker')), row['owner'], ident)


def expiry(value, cfg):
    now = int(time.time())
    if value <= now or value > now + cfg['max_duration_seconds']:
        raise Refused('expiry outside configured window')


def grant(args, cfg):
    if args.slots <= 0 or args.mem_gb <= 0:
        raise Refused('slots and memory must be positive')
    if args.mem_gb > args.slots * cfg['mem_gb_per_slot']:
        raise Refused('memory exceeds the reserved slot capacity')
    if not re.fullmatch(r'[A-Za-z0-9_.:@-]{1,200}', args.owner):
        raise Refused('invalid owner')
    if args.pin:
        if not re.fullmatch(r'\d+(?:,\d+)*', args.pin):
            raise Refused('invalid CPU list')
        cpus = [int(c) for c in args.pin.split(',')]
        if len(set(cpus)) != args.slots * cfg['cpus_per_slot'] or len(cpus) != len(set(cpus)):
            raise Refused('CPU list does not match slot count')
    old = load(args.lease_id)
    proposed = {'lease_id': args.lease_id, 'owner': args.owner, 'user': cfg['user'],
                'slots': args.slots, 'mem_gb': args.mem_gb, 'pin': args.pin,
                'expires': args.expires_epoch}
    if args.expires_epoch <= int(time.time()):
        if old and any(old.get(k) != v for k, v in proposed.items()):
            raise Refused('lease id already exists with different parameters')
        if old:
            result = release(args.lease_id, cfg)
            return {**result, 'expired': True}
        return {'lease_id': args.lease_id, 'expired': True, 'released': True}
    if not old:
        require_free_space(cfg)
    root = workdir_root(cfg)
    expiry(args.expires_epoch, cfg)
    if old:
        if any(old.get(k) != v for k, v in proposed.items()):
            raise Refused('lease id already exists with different parameters')
        proposed = old
    else:
        used = sum(json.loads(p.read_text())['slots'] for p in STATE.glob('*.json'))
        if used + args.slots > cfg['max_slots']:
            raise Refused('box capacity exceeded')
        workdir = root / args.lease_id
        pwd.getpwnam(cfg['user'])
        marker = create_workdir(workdir, args.owner, args.lease_id, args.expires_epoch, cfg['user'])
        proposed.update(created=int(time.time()), workdir=str(workdir), slice=unit(args.lease_id), owner_marker=marker)
        # Persist before creating the unit; a crash cannot make allocated
        # capacity look free. A retry repeats configuration idempotently.
        save(args.lease_id, proposed)
    try:
        run('/usr/bin/systemctl', 'start', unit(args.lease_id))
        props = [f'MemoryMax={args.mem_gb}G']
        if args.pin:
            props.append(f'AllowedCPUs={args.pin}')
        run('/usr/bin/systemctl', 'set-property', '--runtime', unit(args.lease_id), *props)
    except Exception:
        # Keep the reservation: a timeout may have succeeded remotely.
        raise
    proposed['configured'] = True
    save(args.lease_id, proposed)
    audit('grant', args.lease_id)
    return proposed


def release(ident, cfg):
    row = load(ident)
    if not row:
        return {'lease_id': ident, 'released': True, 'already_absent': True}
    # systemd stops the slice and all child units with their normal TERM grace;
    # TimeoutStopSec is configured on the lease's run scope.
    run('/usr/bin/systemctl', 'stop', unit(ident))
    record_path(ident).unlink()
    audit('release', ident)
    result = {'lease_id': ident, 'released': True, 'workdir': row.get('workdir')}
    try:
        root = workdir_root(cfg)
        path = Path(row['workdir'])
        if path.resolve() != root / ident:
            raise Refused('workdir realpath must be the lease directory directly under workdir_root')
        result['workdir_bytes'] = workdir_size_and_remove_if_empty(path, row['user'], row.get('owner_marker'))
        if path.exists():
            refresh_retained_owner(path, row, ident)
    except (Refused, KeyError, TypeError, ValueError, OSError, RuntimeError, subprocess.SubprocessError) as exc:
        result['cleanup_skipped'] = str(exc)
    return result


def probe(ident):
    """Confirm absence only if both our record and the systemd cgroup are gone."""
    if load(ident) is not None:
        return {'lease_id': ident, 'exists': True}
    output = run('/usr/bin/systemctl', 'show', unit(ident), '--property=LoadState',
                 '--property=ActiveState', '--property=ControlGroup', '--no-pager')
    values = dict(line.split('=', 1) for line in output.splitlines() if '=' in line)
    if values.get('LoadState') not in ('loaded', 'not-found') or values.get('ActiveState') != 'inactive' or values.get('ControlGroup') != '':
        raise Refused('cannot confirm the lease slice is absent')
    return {'lease_id': ident, 'exists': False, 'unit_inactive': True}


def reap(cfg):
    released, failed = [], []
    for path in STATE.glob('*.json'):
        try:
            if json.loads(path.read_text())['expires'] <= int(time.time()):
                released.append(release(path.stem, cfg))
        except Exception as exc:  # a corrupt record or failed stop must not block later leases
            failed.append({'lease_id': path.stem, 'error': str(exc)})
            try:
                audit('reap-failed', path.stem, str(exc))
            except OSError:
                pass
    audit('reap', '*')
    return {'released': released, 'failed': failed}


def parser():
    p = argparse.ArgumentParser()
    sub = p.add_subparsers(dest='action', required=True)
    g = sub.add_parser('grant')
    g.add_argument('--lease-id', type=lease_id, required=True)
    g.add_argument('--owner', required=True)
    g.add_argument('--slots', type=int, required=True)
    g.add_argument('--mem-gb', type=int, required=True)
    g.add_argument('--pin')
    g.add_argument('--expires-epoch', type=int, required=True)
    for action in ('release', 'status', 'run', 'probe'):
        q = sub.add_parser(action)
        q.add_argument('--lease-id', type=lease_id, required=True)
        if action == 'run':
            q.add_argument('command', nargs=argparse.REMAINDER)
    e = sub.add_parser('extend')
    e.add_argument('--lease-id', type=lease_id, required=True)
    e.add_argument('--expires-epoch', type=int, required=True)
    sub.add_parser('reap')
    sub.add_parser('drain-check')
    return p


def wait_for_scope(process, scope, lock):
    try:
        deadline = time.monotonic() + 30
        while process.poll() is None:
            active = subprocess.run(['/usr/bin/systemctl', 'is-active', '--quiet', scope],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
            if active:
                break
            if time.monotonic() >= deadline:
                process.terminate()
                process.wait()
                subprocess.run(['/usr/bin/systemctl', 'stop', scope], check=False)
                raise Refused('scope did not become active')
            time.sleep(.05)
        fcntl.flock(lock, fcntl.LOCK_UN)
        return process.wait()
    finally:
        if process.poll() is not None:
            try:
                subprocess.run(['/usr/bin/systemctl', 'reset-failed', scope], check=False,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError:
                pass  # cleanup must not replace the job's exit status


def main():
    args = parser().parse_args()
    if os.geteuid() != 0:
        raise Refused('must run as root')
    cfg = config()
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    state_info = STATE.lstat()
    if STATE.is_symlink() or state_info.st_uid != 0 or state_info.st_mode & 0o077:
        raise Refused('state directory must be root-owned and private')
    with (STATE / '.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if args.action == 'grant':
            result = grant(args, cfg)
        elif args.action == 'release':
            result = release(args.lease_id, cfg)
        elif args.action == 'reap':
            result = reap(cfg)
        elif args.action == 'probe':
            result = probe(args.lease_id)
            audit('probe', args.lease_id)
        elif args.action == 'drain-check':
            # A failed /proc read is not evidence that the box is empty.
            busy = []
            ignored = []
            ignored_dirs = drain_ignore_datadirs(cfg)
            ignored_bytes = {os.fsencode(path): path for path in ignored_dirs}
            processes = {}
            for proc in Path('/proc').iterdir():
                if not proc.name.isdecimal():
                    continue
                try:
                    raw_cmdline = (proc / 'cmdline').read_bytes()
                    cwd = os.readlink(proc / 'cwd')
                except FileNotFoundError:
                    continue
                parent = None
                if ignored_dirs:
                    try:
                        stat = (proc / 'stat').read_text()
                        parent = int(stat.rpartition(')')[2].split()[1])
                    except (FileNotFoundError, IndexError, ValueError):
                        # No reliable ancestry means this process cannot be
                        # ignored on the strength of its parent.
                        pass
                processes[int(proc.name)] = (proc, raw_cmdline, cwd, parent)
            roots = {}
            for pid, (proc, cmdline, cwd, parent) in processes.items():
                argv = cmdline.split(b'\0')
                datadir = next((ignored_bytes[argv[i + 1]] for i in range(len(argv) - 1)
                                if argv[i] == b'-D' and argv[i + 1] in ignored_bytes), None)
                if datadir is not None:
                    try:
                        exe = os.readlink(proc / 'exe')
                    except FileNotFoundError:
                        continue
                    if os.path.basename(exe) == 'postgres':
                        roots[pid] = datadir
            for pid, (proc, cmdline, cwd, parent) in processes.items():
                if b'/ep-lanes/' not in cmdline.replace(b'\0', b' ') and '/ep-lanes/' not in cwd:
                    continue
                datadir = roots.get(pid)
                ancestor = parent
                seen = {pid}
                while datadir is None and ancestor is not None and ancestor not in seen:
                    seen.add(ancestor)
                    datadir = roots.get(ancestor)
                    ancestor = processes[ancestor][3] if ancestor in processes else None
                if datadir is None and cwd in ignored_dirs:
                    try:
                        exe = os.readlink(proc / 'exe')
                    except FileNotFoundError:
                        continue
                    if os.path.basename(exe) == 'postgres':
                        datadir = cwd
                if datadir is None:
                    busy.append(pid)
                else:
                    ignored.append({'pid': pid, 'datadir': datadir})
            result = {'drained': not busy, 'matching_pids': busy, 'ignored_pids': ignored,
                      'max_slots': cfg['max_slots'], 'max_duration_seconds': cfg['max_duration_seconds']}
            audit('drain-check', '*')
        else:
            row = load(args.lease_id)
            if not row:
                raise Refused('unknown lease')
            if args.action == 'extend':
                expiry(args.expires_epoch, cfg)
                if args.expires_epoch < row['expires']:
                    raise Refused('cannot shorten lease')
                row['expires'] = args.expires_epoch
                save(args.lease_id, row)
                audit('extend', args.lease_id)
                result = row
            elif args.action == 'status':
                group = run('/usr/bin/systemctl', 'show', '--property=ControlGroup',
                            '--value', unit(args.lease_id))
                if not group.startswith('/') or '..' in Path(group).parts:
                    raise Refused('invalid cgroup')
                cgroup = Path('/sys/fs/cgroup') / group.lstrip('/')
                cpu = dict(line.split() for line in (cgroup / 'cpu.stat').read_text().splitlines())
                result = dict(row, cpu_usage_usec=int(cpu['usage_usec']),
                              memory_current=int((cgroup / 'memory.current').read_text()),
                              memory_peak=int((cgroup / 'memory.peak').read_text()))
                audit('status', args.lease_id)
            else:
                if not row.get('configured'):
                    raise Refused('lease has not finished configuring')
                if row['expires'] <= int(time.time()):
                    raise Refused('lease expired')
                command = args.command
                if command and command[0] == '--':
                    command = command[1:]
                if not command:
                    raise Refused('missing command')
                workdir = Path(row['workdir'])
                if workdir.resolve(strict=True) != workdir_root(cfg) / args.lease_id:
                    raise Refused('invalid lease workdir')
                command = ['/usr/sbin/runuser', '-u', row['user'], '--',
                           '/usr/bin/env', '--chdir=' + str(workdir), *command]
                if row['pin']:
                    command = ['/usr/sbin/runuser', '-u', row['user'], '--',
                               '/usr/bin/taskset', '-c', row['pin'], *command[4:]]
                # Serialize starting the scope with release. Unlock only once
                # systemd has made the scope active (or the process exited).
                # Otherwise release could tear down the slice between checking
                # the lease and starting a job, letting a late job recreate it.
                scope = 'cmlease-job-' + uuid.uuid4().hex + '.scope'
                audit('run', args.lease_id)
                process = subprocess.Popen(['/usr/bin/systemd-run', '--quiet', '--scope',
                          '--unit=' + scope, '--slice=' + row['slice'],
                          '--property=TimeoutStopSec=30s', '--property=CollectMode=inactive-or-failed',
                          '--', *command])
                sys.exit(wait_for_scope(process, scope, lock))
        print(json.dumps(result, sort_keys=True))
        if args.action == 'reap' and result['failed']:
            sys.exit(3)


if __name__ == '__main__':
    try:
        main()
    except (Refused, OSError, ValueError, KeyError, subprocess.SubprocessError) as exc:
        if os.geteuid() == 0:
            try:
                audit('refused:' + (sys.argv[1] if len(sys.argv) > 1 else 'unknown'), '*')
            except OSError:
                pass
        print(json.dumps({'error': str(exc), 'refused': isinstance(exc, Refused)}), file=sys.stderr)
        sys.exit(3)

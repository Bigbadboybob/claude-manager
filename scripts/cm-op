#!/usr/bin/env python3
"""cm-op — one operator RPC against a cm-daemon, local or over ssh.

    scripts/cm-op daemon.health
    scripts/cm-op daemon.restart '{"binary_path": "/path/to/cm-daemon"}'
    scripts/cm-op --ssh cm-manager daemon.health
    scripts/cm-op --ssh cm-manager --batch '[["worktree.cleanup", {...}], ...]'

Auth: the host's own ~/.cm/operator-token (the TUI mints it locally;
cm-redeploy minted cm-manager's). Socket: $CM_DAEMON_SOCKET or
~/.cm/daemon.sock. Prints the JSON response. For fire-and-verify
methods (daemon.restart, daemon.migrate_split, daemon.split_rollback)
the connection dies at the exec — reported as `"exec": true`; poll
daemon.health afterward (see HOWTO_HOLDER_BRAIN_SPLIT.md).

`--batch` runs a JSON list of [method, params] calls in ONE invocation (one
ssh round trip), a few at a time, and prints a JSON list of responses in the
same order. A call that times out or fails to connect answers
{"error": {"message": ..., "transport": true}} instead of the fire-and-verify
`exec` shape, so a batch caller never mistakes a hung daemon for a successful
exec, and can tell "no answer" (retry) from a daemon refusal (an answer).
`--timeout SECS` bounds each call (default 120).
"""
import json
import os
import pathlib
import shlex
import socket
import struct
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

BATCH_WORKERS = 8

def rpc(method, params, timeout=120, strict=False):
    """One framed call. `strict` (batch mode) raises on a dead or silent
    connection instead of answering the fire-and-verify `exec` shape."""
    home = pathlib.Path.home()
    tok = (home / ".cm/operator-token").read_text().strip()
    sock = os.environ.get("CM_DAEMON_SOCKET") or str(home / ".cm/daemon.sock")
    with socket.socket(socket.AF_UNIX) as s:
        s.settimeout(timeout)
        s.connect(sock)
        req = json.dumps({"id": "cm-op", "caller": {"token_id": tok},
                          "method": method, "params": params}).encode()
        s.sendall(struct.pack(">I", len(req)) + req)
        try:
            hdr = s.recv(4)
            if len(hdr) < 4:
                if strict:
                    raise ConnectionError("connection closed before a response")
                return {"exec": True, "note": "connection died at the exec (fire-and-verify) — poll daemon.health"}
            ln = struct.unpack(">I", hdr)[0]
            buf = b""
            while len(buf) < ln:
                chunk = s.recv(ln - len(buf))
                if not chunk:
                    break
                buf += chunk
            return json.loads(buf)
        except (TimeoutError, ConnectionResetError, BrokenPipeError) as e:
            if strict:
                raise TimeoutError(f"no response within {timeout:g}s") if isinstance(e, socket.timeout) else e
            return {"exec": True, "note": f"connection died ({type(e).__name__}) — poll daemon.health"}

def batch_call(call, timeout):
    method, params = call
    try:
        return rpc(method, params, timeout, strict=True)
    except Exception as e:  # noqa: BLE001 - one bad call must not sink the batch
        return {"error": {"message": f"{method}: {type(e).__name__}: {e}", "transport": True}}

def main(argv):
    ssh_host = None
    timeout = None
    args = list(argv)
    while args[:1] in (["--ssh"], ["--timeout"]):
        if args[0] == "--ssh":
            ssh_host = args[1]
        else:
            timeout = float(args[1])
        args = args[2:]
    if not args or (args[0] == "--batch" and len(args) < 2):
        print(__doc__)
        return 2
    if ssh_host:
        # Run THIS script remotely (the token and socket are host-local).
        me = pathlib.Path(__file__).read_text()
        remote_args = (["--timeout", str(timeout)] if timeout is not None else []) + [args[0], args[1] if len(args) > 1 else "{}"]
        remote = subprocess.run(
            ["ssh", "-o", "ConnectTimeout=15", ssh_host,
             "python3 - " + shlex.join(remote_args)],
            input=me, capture_output=True, text=True)
        sys.stdout.write(remote.stdout)
        sys.stderr.write(remote.stderr)
        return remote.returncode
    if args[0] == "--batch":
        calls = json.loads(args[1])
        per_call = 120 if timeout is None else timeout
        with ThreadPoolExecutor(max_workers=BATCH_WORKERS) as pool:
            print(json.dumps(list(pool.map(lambda c: batch_call(c, per_call), calls))))
        return 0
    method = args[0]
    params = json.loads(args[1]) if len(args) > 1 else {}
    print(json.dumps(rpc(method, params, 120 if timeout is None else timeout), indent=1))
    return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

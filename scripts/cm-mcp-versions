#!/usr/bin/env python3
"""Which CM MCP code each live agent session on a host is running.

The release lead's old-version view (doc/mcp-managed-activation.md §7):
one row per live MCP server, stalest first, against the payload the host's
launcher would start now. Read-only; it never activates anything.

  scripts/cm-mcp-versions                 # this host
  scripts/cm-mcp-versions --ssh cm-sessions
  scripts/cm-mcp-versions --json
"""

import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

CM = Path.home() / ".cm"


def _json(path):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return None


def _alive(pid):
    if not pid:
        return False
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError):
        return False


def deployed():
    """The payload the launcher's first candidate would start."""
    candidates = _json(CM / "mcp" / "launcher-candidates.json") or []
    for item in candidates:
        root = Path(item.get("server", "")).parent
        if (root / "server.py").is_file():
            stamp = _json(root / "VERSION")
            return {"dir": str(root), "version": (stamp or {}).get("version"),
                    "payload_hash": (stamp or {}).get("payload_hash")}
    return {"dir": None, "version": None, "payload_hash": None}


def _environ(pid):
    try:
        raw = Path(f"/proc/{pid}/environ").read_bytes()
    except OSError:
        return {}
    return dict(item.split("=", 1) for item in raw.decode(errors="replace").split("\0") if "=" in item)


def _start_time(pid):
    try:
        ticks = int(Path(f"/proc/{pid}/stat").read_text().rsplit(") ", 1)[1].split()[19])
        boot = float(next(line.split()[1] for line in Path("/proc/stat").read_text().splitlines()
                          if line.startswith("btime")))
        return boot + ticks / os.sysconf("SC_CLK_TCK")
    except (OSError, ValueError, StopIteration, IndexError):
        return None


def live_servers():
    """{uid: [(pid, env)]} for every running server.py with a CM identity."""
    found = {}
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            argv = (proc / "cmdline").read_bytes().split(b"\0")
        except OSError:
            continue
        if not any(a.endswith(b"mcp_server/server.py") for a in argv[:3]):
            continue
        env = _environ(proc.name)
        uid = env.get("CM_TUI_SESSION_ID")
        if uid:
            found.setdefault(uid, []).append((int(proc.name), env))
    return found


def collect():
    target = deployed()
    names = {}
    for uid, entry in ((_json(CM / "daemon-sessions.json") or {}).get("messaging_names") or {}).items():
        names[uid] = entry.get("name")
    rows = []
    for uid, procs in sorted(live_servers().items()):
        for pid, env in procs:
            status = _json(CM / "mcp" / uid / "status.json") or {}
            proxy = _json(CM / "mcp" / uid / "proxy.json") or {}
            current = status.get("pid") == pid
            behind_proxy = env.get("CM_MCP_PROXY_CHILD") == "1"
            version = status.get("version") if current else None
            payload = status.get("payload_hash") if current else None
            started = status.get("started_at") if current else _start_time(pid)
            if not current:
                state = "pre-status code"
            elif target["payload_hash"] and payload == target["payload_hash"]:
                state = "current"
            else:
                state = "behind"
            notes = []
            if not behind_proxy:
                notes.append("no proxy: needs one manual /mcp reconnect")
            elif proxy.get("state") not in (None, "running"):
                notes.append(f"proxy {proxy.get('state')}: {proxy.get('last_error')}")
            if current and status.get("pending"):
                notes.append(f"pending {status['pending']['version']}"
                             + (f" (blocked: {status['blocked']})" if status.get("blocked") else ""))
            last = proxy.get("last_activation") or {}
            if last and not last.get("ok"):
                notes.append(f"last activation failed: {last.get('error')}")
            if status.get("tools_changed_unseen"):
                notes.append("tool set changed, not visible until restart")
            rows.append({
                "uid": uid, "name": names.get(uid), "pid": pid,
                "engine": env.get("CM_AGENT_ENGINE"), "proxy": behind_proxy,
                "generation": (status.get("proxy") or {}).get("generation") if current else None,
                "version": version, "state": state,
                "age_h": round((time.time() - started) / 3600, 1) if started else None,
                "notes": notes,
            })
    order = {"pre-status code": 0, "behind": 1, "current": 2}
    rows.sort(key=lambda r: (order[r["state"]], -(r["age_h"] or 0)))
    return {"host": os.uname().nodename, "deployed": target, "sessions": rows}


def render(report):
    out = [f"host {report['host']}: launcher payload {report['deployed']['dir']} "
           f"version {report['deployed']['version'] or 'unstamped'}"]
    counts = {}
    for row in report["sessions"]:
        counts[row["state"]] = counts.get(row["state"], 0) + 1
    out.append("  " + ", ".join(f"{n} {k}" for k, n in counts.items()) if counts else "  no live MCP servers")
    out.append(f"{'uid':24} {'name':22} {'engine':11} {'proxy':5} {'version':16} {'state':15} {'age_h':>6}  notes")
    for row in report["sessions"]:
        out.append(f"{row['uid']:24} {(row['name'] or '-')[:22]:22} {(row['engine'] or '-'):11} "
                   f"{('g' + str(row['generation'])) if row['proxy'] and row['generation'] else ('yes' if row['proxy'] else 'no'):5} "
                   f"{(row['version'] or '?')[:16]:16} {row['state']:15} {row['age_h'] if row['age_h'] is not None else '?':>6}  "
                   + "; ".join(row["notes"]))
    return "\n".join(out)


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--ssh", help="run on this ssh host instead")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    if args.ssh:
        cmd = ["ssh", args.ssh, "python3", "-", "--json"]
        result = subprocess.run(cmd, input=Path(__file__).read_bytes(), capture_output=True)
        if result.returncode:
            sys.exit(result.stderr.decode(errors="replace"))
        report = json.loads(result.stdout)
    else:
        report = collect()
    print(json.dumps(report, indent=1) if args.json else render(report))


if __name__ == "__main__":
    main()

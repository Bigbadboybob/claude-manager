# Copy to /etc/cm-board-web.env, root:lucas 0640. No quote/backtick expansion.
CF_ACCESS_TEAM_DOMAIN=YOUR-TEAM.cloudflareaccess.com
CF_ACCESS_AUD=REPLACE-WITH-APPLICATION-AUD-TAG
CF_ACCESS_EMAIL=REPLACE-WITH-OWNER-EMAIL
BOARD_ORIGIN=https://board.latentoracle.xyz
BOARD_DAEMON_SOCKET=/home/lucas/.cm/daemon.sock
BOARD_OPERATOR_TOKEN_FILE=/home/lucas/.cm/operator-token
BOARD_PUSH_PATH=/home/lucas/.cm/web-push
BOARD_STATIC_PATH=/opt/cm-board-web/web/static

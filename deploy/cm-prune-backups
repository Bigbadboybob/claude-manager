#!/usr/bin/env bash
# Delete CM deploy backups older than CM_PRUNE_DAYS (default 7), always
# keeping the newest CM_PRUNE_KEEP (default 3) of each kind. The holder pins
# its rollback brain by open fd, so no file here is load-bearing.
# Usage: cm-prune-backups [--dry-run]
set -euo pipefail
days=${CM_PRUNE_DAYS:-7}
keep=${CM_PRUNE_KEEP:-3}
dry=0
[ "${1:-}" = "--dry-run" ] && dry=1

# dir|glob — one backup kind per line.
kinds=(
  "/opt/cm-daemon|cm-daemon.bak*"
  "/opt/cm-daemon|cm-daemon.before*"
  "/opt/cm-daemon|mcp_server.before*"
  "/opt/claude-manager|api-before-*.tgz"
  "/home/lucas/.local/share/swarm-coord/api-backups|pre-*"
  "/home/lucas/.local/share/swarm-coord/deploy|mcp-backup-pre-*"
  "/home/lucas/.local/share/swarm-coord/db-backups|*.dump"
)

for kind in "${kinds[@]}"; do
  dir=${kind%%|*} glob=${kind#*|}
  [ -d "$dir" ] || continue
  # Newest first; skip the first $keep, then delete the rest past the age.
  find "$dir" -maxdepth 1 -mindepth 1 -name "$glob" -printf '%T@ %p\n' \
    | sort -rn | tail -n +$((keep + 1)) | while read -r _ path; do
      if [ -n "$(find "$path" -maxdepth 0 -mtime +"$days")" ]; then
        echo "prune $path"
        [ $dry -eq 1 ] || rm -rf -- "$path"
      fi
    done
done
